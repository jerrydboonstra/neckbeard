#!/usr/bin/env bash
# vet TARGET OUT [--judge reader|own] [--model MODEL] [--repo URL] [--note TEXT] [--units]: vet one plugin against the sample reader, headless,
# and write the report to OUT. This is the gallery method in one command, for a plugin that publishes its report
# and wants to rebuild it, say in a Claude Code web session on its own repo:
#   git clone --depth 1 https://github.com/jerrydboonstra/neckbeard /tmp/nb && /tmp/nb/tools/vet . docs/neckbeard-report.md
#   1. copy examples/reader to a throwaway folder: the judge writes into its config folder (backups/, projects/,
#      synced skills), and that must never land in this checkout
#   2. inventory TARGET with that copy as the config folder and an empty project, so the only rules in force are
#      the reader's; refuse if the dossier read anything outside the copy
#   3. judge in a separate `claude -p` session started in the empty project, following SKILL.md Steps 2 to 4.
#      --judge reader (the default) gives it the copy as its config folder too, so it starts with the reader's
#      rules and nothing else; that needs a login from the environment, as a web session has. Where it can't log
#      in that way (a Mac keeps its login with the default config), it falls back to --judge own, the caller's
#      own config, and says so: the judge is told to ignore those instructions but still starts with them
#   4. check the report: it exists, carries a verdict, and names no local path; set its title line, which
#      says the verdict is against the sample reader
# --units (a prototype, verdict-prototype-units): number the target's sections with tools/rule-units, have the judge
# answer every one by the written tests in tools/vet-units.md, and take the verdict from tools/units-verdict. Keeps
# OUT's stem .units.json and .answers.json beside the report; fails when the answers or the banner don't match.
# --repo names the target's public GitHub repo when the checkout's origin is a private copy (a web session on a
# -dev sidecar); --note adds a sentence before the "Verdict is relative" one, such as a self-vetting notice.
# Exit 0 only when the report passed every check. Kept out of bin/, which a plugin puts on every session's PATH.
#
# vet --check REPORT TARGET: the staleness check for a plugin's CI. Needs only python3, no claude and no login.
# Exit 0 when REPORT's header names the version in TARGET's plugin.json, 1 when it names another version or
# has no header to read.
set -u
usage() {
  echo "usage: tools/vet TARGET OUT [--judge reader|own] [--model MODEL] [--repo URL] [--note TEXT] [--units]" >&2
  echo "       tools/vet --check REPORT TARGET" >&2
  exit 2
}
die() { echo "vet: $*" >&2; exit 1; }
plugin_version() { python3 -c 'import json,sys
for f in (".claude-plugin/plugin.json", "plugin.json", "package.json"):
    try: print(json.load(open(sys.argv[1] + "/" + f))["version"]); break
    except Exception: pass' "$1"; }

if [ "${1:-}" = --check ]; then
  [ $# -eq 3 ] || usage
  report=$2 target=$3
  [ -f "$report" ] || die "no report at $report"
  [ -d "$target" ] || die "$target is not a folder"
  want=$(plugin_version "$target")
  [ -n "$want" ] || die "no version in $target's plugin.json"
  # the header line tools/vet writes: `DATE` · neckbeard X · <name or [name](url)> VERSION[ @ `commit`]
  got=$(python3 -c 'import re,sys
for line in open(sys.argv[1], encoding="utf-8"):
    m = re.match(r"^`\d{4}-\d{2}-\d{2}` · neckbeard \S+ · (?:\[[^\]]+\]\([^)]+\)|\S+) (\S+)(?: @ |\s*$)", line)
    if m: print(m.group(1)); break' "$report")
  [ -n "$got" ] || die "$report has no header line naming a version"
  [ "$got" = "$want" ] || die "$report vets $got, but $target is $want: rebuild it (see examples/README.md)"
  echo "vet: $report is current ($want)"
  exit 0
fi
[ $# -ge 2 ] || usage
target=$1 out=$2; shift 2
judge=auto model=${NECKBEARD_MODEL:-sonnet} repo="" note="" units=no
while [ $# -gt 0 ]; do case $1 in
  --judge) [ $# -ge 2 ] || usage; case $2 in reader|own) judge=$2 ;; *) usage ;; esac; shift 2 ;;
  --model) [ $# -ge 2 ] || usage; model=$2; shift 2 ;;
  --repo) [ $# -ge 2 ] || usage; case $2 in https://github.com/*/*) repo=${2%/} ;; *) usage ;; esac; shift 2 ;;
  --note) [ $# -ge 2 ] || usage; note=$2; shift 2 ;;
  --units) units=yes; shift ;;
  *) usage ;;
esac; done

nb=$(cd "$(dirname "$0")/.." && pwd -P)
[ -d "$target" ] || die "$target is not a folder"
target=$(cd "$target" && pwd -P)
mkdir -p "$(dirname "$out")" || die "can't make the folder for $out"
out=$(cd "$(dirname "$out")" && pwd -P)/$(basename "$out")
command -v claude >/dev/null || die "no claude on PATH"
command -v python3 >/dev/null || die "no python3 on PATH"

# 1. a throwaway reader and an empty project, removed however this exits
work=$(mktemp -d "${TMPDIR:-/tmp}/neckbeard-vet.XXXXXX") || die "mktemp failed"
trap 'rm -rf "$work"' EXIT
reader=$work/reader project=$work/project
cp -R "$nb/examples/reader" "$reader" && mkdir "$project" || die "couldn't copy the sample reader"
reader=$(cd "$reader" && pwd -P) project=$(cd "$project" && pwd -P)

# 2. the dossier
dossier=$project/dossier.json
# its note about the dossier holding your rules is moot here: the dossier is deleted on exit
CLAUDE_CONFIG_DIR=$reader python3 "$nb/skills/neckbeard/inventory.py" "$target" --project-dir "$project" --out "$dossier" >"$work/inventory.log" 2>&1 ||
  { cat "$work/inventory.log" >&2; die "the inventory failed"; }
python3 - "$dossier" "$reader" <<'EOF' || die "the dossier read rules from outside the sample reader"
import json, os, sys
rules = json.load(open(sys.argv[1])).get("current_rules", {}).get("items", [])
paths = [r.get("path") or "" for r in rules]
root = os.path.realpath(sys.argv[2]) + os.sep
sys.exit(0 if paths and all(os.path.realpath(p).startswith(root) for p in paths) else 1)
EOF

# 3. the judge
if [ "$judge" = auto ]; then
  if (cd "$project" && CLAUDE_CONFIG_DIR=$reader timeout 120 claude -p --model "$model" "Reply with the single word ok" 2>&1) | grep -qx ok; then
    judge=reader
  else
    judge=own
    echo "vet: the judge can't log in with the sample reader as its config folder here, so it runs with your own config and is told to ignore it" >&2
  fi
fi
version=$(plugin_version "$target")
commit=$(git -C "$target" rev-parse --short HEAD 2>/dev/null || true)
remote=$(git -C "$target" remote get-url origin 2>/dev/null | sed -E 's#^git@github\.com:#https://github.com/#; s#\.git$##' || true)
case $remote in https://github.com/*) ;; *) remote="" ;; esac
[ -n "$repo" ] && remote=${repo%.git}
nbversion=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["version"])' "$nb/.claude-plugin/plugin.json")
name=$(basename "$target")
[ -n "$remote" ] && name=${remote#https://github.com/}
source=$name
[ -n "$remote" ] && source="[$name]($remote)"
title="# 🔍 ${name##*/}${version:+ $version} · vetted against the sample reader"
prompt=$work/prompt.md
cat > "$prompt" <<EOF
Vet one plugin with neckbeard against the SAMPLE READER and write the report.

TARGET: $name${version:+ $version}, checked out at $target${commit:+ (commit $commit)}.
DOSSIER (already built, read-only): $dossier. It was built with the sample reader as the config folder and an empty project, so current_rules is exactly the sample reader's files, under $reader. Those are the only rules already in force. Ignore every other instruction file in your own context (any CLAUDE.md, memory or skill you were started with): they are not the reader's.
METHOD: $nb/skills/neckbeard/SKILL.md. Step 1 is done (the dossier). Follow Steps 2 to 4 as written, using the report shape in Step 3 exactly.
REPORT FILE (the only file you create): $out

Header line to use: \`$(date +%Y-%m-%d)\` · neckbeard $nbversion · $source${version:+ $version}${commit:+ @ \`$commit\`}
Title line to use: $title
Put this paragraph in the verdict block, after the summary: "${note:+$note }Verdict is relative to the [sample reader](https://github.com/jerrydboonstra/neckbeard/tree/main/examples/reader), not a judgment of the plugin's quality. Reproduce: see [examples/README.md](https://github.com/jerrydboonstra/neckbeard/blob/main/examples/README.md)."

Rules:
- Read only the target, the dossier, the method and the sample reader. Judge from those and form your own view: if the target ships an earlier neckbeard report, treat it as documentation, not as an answer.
- Write nothing except the REPORT FILE. Edit nothing else. No git commands that change anything.
- Cite reader rules as examples/reader/... paths, never by the folder above. Quote rules only as short phrases. Name no local path in the report: nothing under $target, $work or a home folder; cite the target's files by their path inside the target.
- Plain prose: no em dashes, one line per paragraph, counts that match the grids, the Key line on one line. Reread the report once it is written and fix any count that doesn't match.

Reply with the verdict line and the counts (conflicts / covered / new standing / new skill / dropped).
EOF
if [ "$units" = yes ]; then
  stem=${out%.md}
  unitsf=$stem.units.json answers=$stem.answers.json cands=$stem.candidates.json confs=$stem.confirmations.json confirmed=$stem.confirmed.json
  rm -f "$answers" "$cands" "$confs" "$confirmed" "$stem".finds-*.json
  python3 "$nb/tools/rule-units" "$dossier" "$unitsf" >&2 || die "rule-units failed"
  test_text=$(cat "$nb/tools/vet-conflict-test.md")
  ucfg=()
  [ "$judge" = reader ] && ucfg=(env CLAUDE_CONFIG_DIR="$reader")
  usage_log=$work/usage.log
  # an isolated judge call: PROMPT-FILE in, its text answer on stdout; its cost and time go to the usage log
  call() { # call TOOLS PROMPT-FILE
    (cd "$project" && "${ucfg[@]}" claude -p --model "$model" --allowedTools "$1" --output-format json < "$2") |
      python3 -c 'import json,sys
r = json.load(sys.stdin)
print(r.get("result", ""))
open(sys.argv[1], "a").write("%s %s\n" % (r.get("total_cost_usd", 0), r.get("duration_ms", 0)))' "$usage_log"
  }
  # 3a. three find passes, side by side, each writing its own candidates
  for i in 1 2 3; do
    python3 -c 'import sys
print(open(sys.argv[1], encoding="utf-8").read().format(units=sys.argv[2], dossier=sys.argv[3], finds=sys.argv[4], test=sys.argv[5]))' \
      "$nb/tools/vet-find.md" "$unitsf" "$dossier" "$stem.finds-$i.json" "$test_text" >"$work/find-$i.md"
    call Read,Write,Glob,Grep "$work/find-$i.md" >"$work/find-$i.out" 2>"$work/find-$i.err" &
  done
  wait
  for i in 1 2 3; do [ -s "$stem.finds-$i.json" ] || die "find pass $i wrote no candidates ($(head -c 300 "$work/find-$i.out" "$work/find-$i.err"))"; done
  python3 "$nb/tools/units-confirm" pool "$unitsf" "$cands" "$stem".finds-[123].json >&2 || die "pooling the candidates failed"
  # 3b. each candidate confirmed alone: it sees the reader rule, the sentence and the written test, and nothing else
  python3 -c 'import json,sys
for c in json.load(open(sys.argv[1]))["candidates"]:
    open("%s/confirm-%s.rule" % (sys.argv[2], c["cid"]), "w").write(c["reader_rule"])
    open("%s/confirm-%s.sentence" % (sys.argv[2], c["cid"]), "w").write(c["quote"])' "$cands" "$work"
  for f in "$work"/confirm-*.rule; do
    [ -e "$f" ] || break
    cid=${f##*/confirm-}; cid=${cid%.rule}
    python3 -c 'import sys
print(open(sys.argv[1], encoding="utf-8").read().format(rule=open(sys.argv[2]).read(), sentence=open(sys.argv[3]).read(), test=sys.argv[4]))' \
      "$nb/tools/vet-confirm.md" "$f" "$work/confirm-$cid.sentence" "$test_text" >"$work/confirm-$cid.md"
    call "" "$work/confirm-$cid.md" >"$work/confirm-$cid.out" 2>"$work/confirm-$cid.err" &
  done
  wait
  # a confirm call that answered with no JSON (a refusal, a hiccup) gets one more try, alone
  for f in "$work"/confirm-*.md; do
    [ -e "$f" ] || break
    cid=${f##*/confirm-}; cid=${cid%.md}
    grep -q '"conflict"' "$work/confirm-$cid.out" || call "" "$f" >"$work/confirm-$cid.out" 2>"$work/confirm-$cid.err"
  done
  python3 - "$cands" "$work" "$confs" "$confirmed" <<'PYEOF' || die "a confirm call gave no usable answer"
import json, re, sys
cands = json.load(open(sys.argv[1]))["candidates"]
confs, kept = [], []
for c in cands:
    text = ""
    try:
        text = open(f"{sys.argv[2]}/confirm-{c['cid']}.out", encoding="utf-8").read()
        a = json.loads(re.search(r"\{.*\}", text, re.S).group(0))
        assert isinstance(a["conflict"], bool)
    except Exception:
        print(f"vet: the confirm call for {c['cid']} gave no usable answer: {text[:200]!r}", file=sys.stderr)
        sys.exit(1)
    confs.append({"cid": c["cid"], "conflict": a["conflict"], "why": str(a.get("why", ""))})
    if a["conflict"]:
        kept.append({**c, "why": str(a.get("why", ""))})
json.dump({"confirmations": confs}, open(sys.argv[3], "w"), indent=1)
json.dump({"confirmed": kept}, open(sys.argv[4], "w"), indent=1)
print(f"vet: units: {len(kept)} of {len(cands)} candidates confirmed", file=sys.stderr)
PYEOF
  python3 - "$nb/tools/vet-units.md" "$unitsf" "$answers" "$nb" "$confirmed" "$cands" "$confs" >>"$prompt" <<'PYEOF' || die "couldn't write the units addendum"
import sys
print("\n" + open(sys.argv[1], encoding="utf-8").read().format(units=sys.argv[2], answers=sys.argv[3], nb=sys.argv[4], confirmed=sys.argv[5], cands=sys.argv[6], confs=sys.argv[7]))
print("The ANSWERS file above is the one file you may write besides the REPORT FILE.")
PYEOF
fi
cfg=()
[ "$judge" = reader ] && cfg=(env CLAUDE_CONFIG_DIR="$reader")
rm -f "$out"
(cd "$project" && "${cfg[@]}" claude -p --model "$model" --allowedTools Bash,Read,Write,Edit,Glob,Grep --output-format text < "$prompt") ||
  die "the judge exited non-zero"

# 4. the report
[ -s "$out" ] || die "the judge wrote no report to $out"
grep -qE '^> ## (🟥|🟧|🟨|🟩) ' "$out" || die "$out carries no verdict banner"
if [ "$units" = yes ]; then
  # whatever the judge wrote under conflicts, only the confirmed ones count: put them in again, as the judge was told to
  python3 "$nb/tools/units-confirm" merge "$cands" "$confs" "$answers" >/dev/null || die "couldn't put the confirmed conflicts into the answers"
  computed=$(python3 "$nb/tools/units-verdict" "$unitsf" "$answers") || { echo "$computed" >&2; die "the judge's answers were refused"; }
  echo "vet: units: $computed" >&2
  python3 - "$usage_log" "$SECONDS" <<'PYEOF' >&2
import sys
try: rows = [l.split() for l in open(sys.argv[1]) if l.strip()]
except OSError: rows = []
print(f"vet: units cost: {len(rows)} find and confirm calls, ${sum(float(r[0]) for r in rows):.2f}, {sum(int(float(r[1])) for r in rows) // 1000} s of call time; whole vet {sys.argv[2]} s (the report pass is not in the dollars)")
PYEOF
  v=$(printf '%s\n' "$computed" | sed -E 's/^[^:]*: ([^;]+);.*/\1/')
  bv=$(grep -E '^> ## ' "$out" | head -n 1 | sed -E 's/^> ## [^ ]+ //; s/ · .*//')
  case $bv in "$v"|"$v /"*) ;; *) die "the banner says $bv, but the computed verdict is $v" ;; esac
fi
# the title says whose rules these are; a judge started with its own rules has been seen to write "your rules"
case $(head -n 1 "$out") in "# 🔍 "*) ;; *) die "$out has no 🔍 title line" ;; esac
python3 - "$out" "$title" <<'EOF'
import sys
lines = open(sys.argv[1], encoding="utf-8").read().split("\n")
if lines[0] != sys.argv[2]:
    print(f"vet: title was {lines[0]!r}, set to {sys.argv[2]!r}", file=sys.stderr)
    lines[0] = sys.argv[2]
    open(sys.argv[1], "w", encoding="utf-8").write("\n".join(lines))
EOF
for p in "$work" "$(cd "$work" && pwd -P)" "$target" "${HOME:-/nonexistent}"; do
  [ "$p" = / ] && continue
  grep -qF -- "$p" "$out" && die "$out names a local path ($p); fix it by hand or rerun"
done
echo "vet: report $out (judge: $judge)"
