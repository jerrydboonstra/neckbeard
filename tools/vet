try: rows = [l.split() for l in open(sys.argv[1]) if l.strip()]
except OSError: rows = []
print(f"vet: units cost: {len(rows)} calls, ${sum(float(r[0]) for r in rows):.2f}, {sum(int(float(r[1])) for r in rows) // 1000} s of call time; whole vet {sys.argv[2]} s")
PYEOF2
fi   # session mode skips the judge steps above

# 4. the report: title, header, Contents, then the three layers (the summary rows, then the fit strip and cards, the facts, the positions)
python3 "$nb/tools/fit" "$verdictf" "$prose" --label "$label" --target "${name##*/}" --verdict-text "${note:+$note }$verdict_text" --baseline "$baseline_file" >"$work/fit.md" || die "the fit report could not be drawn from $verdictf and $prose"
assemble "$work/report.md" "$title" "$header" "$label" "$work/fit.md" ""
check_report "$work/report.md" no
cp "$work/report.md" "$out" || die "couldn't write $out"
login_scan || die "the report held your login's secrets, so no report was written"
rm -f "$credtokens"   # kept until here: the finished report, with part 1 from the dossier, is the last thing scanned; the work folder goes at exit
for p in "$work" "$(cd "$work" && pwd -P)" "$target" "$readerdir" "${HOME:-/nonexistent}" "$(cd "${HOME:-/nonexistent}" 2>/dev/null && pwd -P)" "$(python3 -c 'import json,sys
print(json.load(open(sys.argv[1])).get("current_rules", {}).get("project_root") or "")' "$dossier" 2>/dev/null)"; do
  [ "$p" = / ] || [ -z "$p" ] && continue
  grep -qF -- "$p" "$out" && { rm -f "$out"; die "$out names a local path ($p); fix it by hand or rerun"; }
done
echo "vet: report $out (judge: $judge)"
