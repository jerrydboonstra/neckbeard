#!/usr/bin/env bash
# vet TARGET OUT [--judge reader|own] [--model MODEL] [--repo URL] [--note TEXT] [--units] [--reader DIR] [--facts] [--release-tag TAG]: vet one plugin against the sample reader, headless,
# and write the report to OUT. This is the gallery method in one command, for a plugin that publishes its report
# and wants to rebuild it, say in a Claude Code web session on its own repo:
#   git clone --depth 1 https://github.com/jerrydboonstra/neckbeard /tmp/nb && /tmp/nb/tools/vet . docs/neckbeard-report.md
#   1. copy examples/reader to a throwaway folder: the judge writes into its config folder (backups/, projects/,
#      synced skills), and that must never land in this checkout
#   2. inventory TARGET with that copy as the config folder and an empty project, so the only rules in force are
#      the reader's; refuse if the dossier read anything outside the copy
#   3. the fit report, from a fixed list of the plugin's rule units (verdict-stability-rules): tools/rule-units lists the units;
#      three find passes pool their conflict candidates and tools/units-confirm confirms each in a call of its own; the answering
#      judge (tools/vet-units.md) answers every unit; tools/units-verdict computes the verdict and counts by code; the prose judge
#      (tools/vet-prose.md) writes only the Why paragraph, the Do this steps and the rules patch; tools/fit draws the verdict strip
#      and the seven fit cards. Every call is a separate `claude -p` session started in the empty project.
#      --judge reader (what the default tries first) gives it the copy as its config folder too, so it starts with the reader's
#      rules and nothing else; that needs a login from the environment, as a web session has, or on Linux a copy of
#      your login file for the run (for the default judge and for an explicit --judge reader alike). Where the default judge can't
#      log in (a Mac keeps its login with the default config), it falls back to --judge own, the caller's own config, and says so
#      and why: the judge is told to ignore those instructions but still starts with them. The fallback is for the default judge
#      (no --judge given) only: an explicit --judge reader never falls back, and when it can't log in it stops, naming why and
#      --judge own. The report carries a "Judge:" line beside the Baseline line saying which judge ran.
#   4. the report: the title and header lines (written here), the fit strip and cards, then tools/part1's "What it adds" (what the
#      target injects, reaches and leaves behind, read from the dossier, with no reference to the reader); check it names no local path
# OUT's stem .units.json, .answers.json, .verdict.json, .prose.json, .candidates.json, .confirmations.json, .confirmed.json and
# .finds-N.json are kept beside the report: the evidence for its verdict. --units is a no-op, kept for 2.0 (the units path is the default).
# --repo names the target's public GitHub repo when the checkout's origin is a private copy (a web session on a
# -dev sidecar); --note adds a sentence before the "Verdict is relative" one, such as a self-vetting notice.
# --reader DIR vets against another reader instead: a folder laid out as a Claude config folder, copied the same way. The header
# then gains a `Baseline:` line (the label, the number of rule files in the dossier's current_rules.items, their bytes and a
# fingerprint of their relative paths and contents) with the relative paths in a <details> block; tools/vet writes it after the
# judge has, never the judge. The label is "the sample reader" for the default, else the folder's name, and the title and the
# "Verdict is relative to" paragraph carry it. A reader whose dossier lists no rule files gets the --facts report instead
# (one stderr line says why, exit 0), with no claude needed. The reader is the config folder of the judge's session, so its
# settings.json hooks run: vet only readers you trust.
# --facts also prints, as the last line of stdout, one Markdown badge line for OUT (label "neckbeard", message
# "<version> · <read state>", coloured by the dossier's read_status: failed gives red "something unread", partial yellow
# "partly read", else brightgreen "read in full"), linked to OUT's path as given. Its other messages go to stderr.
# The commit label (the header's "@ `...`", Source's "Commit:" line and the dossier's "(commit ...)") is the short sha of the target's
# HEAD, with " + uncommitted changes" after it when `git status --porcelain --untracked-files=no` prints anything (the files read are
# not HEAD's). --facts --release-tag TAG makes the label TAG instead and wins over the dirty rule: a report committed into a tagged
# tree cannot name the commit that contains it, so `make report` names the tag.
# --facts writes the facts report instead: no reader, no verdict and no model call (claude need not be on PATH). The config
# folder is a fresh empty one, the dossier must read no rules at all, and OUT is the title line `# 🔍 <name> <version> ·
# what it adds`, the same header line the judged report carries, tools/part1's "What it adds", and one closing line.
# It takes --repo and --release-tag; with --judge, --model, --units, --note or --reader it is a usage error. Blank lines separate the four parts.
# Exit 0 only when the report passed every check (--facts has one: it names no local path, checked before OUT is written). Kept out of bin/, which a plugin puts on every session's PATH.
#
# vet --check REPORT TARGET: the staleness check for a plugin's CI. Needs only python3, no claude and no login.
# Exit 0 when REPORT's header names the version in TARGET's plugin.json, 1 when it names another version or
# has no header to read.
# Targets bash 3.2, the /bin/bash on a Mac (what `#!/usr/bin/env bash` finds when Homebrew is not on PATH): no bash-4 features,
# and an array that may be empty is expanded as ${a[@]+"${a[@]}"}, because under set -u bash before 4.4 calls an empty one unbound.
set -u
usage() {
  echo "usage: tools/vet TARGET OUT [--judge reader|own] [--model MODEL] [--repo URL] [--note TEXT] [--units] [--reader DIR] [--facts] [--release-tag TAG]" >&2
  echo "       --units is a no-op: the units path is the default" >&2
  echo "       --facts takes only --repo and --release-tag" >&2
  echo "       tools/vet --check REPORT TARGET" >&2
  exit 2
}
# While a login copy exists (credcopy=yes), no token of it may reach vet's output or a file beside OUT. login_scan checks OUT,
# the judge's stdout and the files beside OUT, and removes them all on a hit; die redacts the tokens from its message first.
login_files() {   # the files to check, one per NUL-terminated entry, so a path with spaces stays whole
  local stem=${out%.md} f
  for f in "$out" "$stem".units.json "$stem".answers.json "$stem".verdict.json "$stem".prose.json "$stem".candidates.json "$stem".confirmations.json "$stem".confirmed.json "$stem".finds-*.json "${work:-/nonexistent}"/*.err "${work:-/nonexistent}"/find-*.out "${work:-/nonexistent}"/answer.out "${work:-/nonexistent}"/prose.out "${work:-/nonexistent}"/confirm-*.out "${work:-/nonexistent}"/probe.out "${work:-/nonexistent}"/*.md.json; do
    [ -e "$f" ] && printf '%s\0' "$f"
  done
}
login_scan() {   # returns 1 and removes the files when one holds a token of the login
  [ "${credcopy:-no}" = yes ] && [ -s "${credtokens:-}" ] || return 0
  login_files >"$work/login.files"
  python3 - "$credtokens" "${reader:-/nonexistent}/.credentials.json" "${work:-/nonexistent}/judge.out" "$work/login.files" <<'PYEOF' && return 0
import json, os, sys
toks = [t for t in open(sys.argv[1]).read().split("\n") if t]
try:   # a login the judge refreshed holds new tokens
    o = json.load(open(sys.argv[2]))["claudeAiOauth"]
    toks += [o[k] for k in ("accessToken", "refreshToken") if isinstance(o.get(k), str) and o[k]]
except Exception:
    pass
files = [sys.argv[3]] + [p for p in open(sys.argv[4], "rb").read().decode().split("\0") if p]
sys.exit(1 if any(os.path.isfile(p) and any(t.encode() in open(p, "rb").read() for t in toks) for p in files) else 0)
PYEOF
  while IFS= read -r -d '' f; do rm -f "$f"; done <"$work/login.files"; return 1
}
safe_tail() {   # safe_tail FILE N: the last N lines of FILE to stderr, any line holding a token of the login dropped
  [ -s "$1" ] || return 0
  python3 - "$1" "$2" "${credtokens:-/nonexistent}" "${reader:-/nonexistent}/.credentials.json" <<'PYEOF' >&2
import json, sys
toks = []
try: toks += [t for t in open(sys.argv[3]).read().split("\n") if t]
except Exception: pass
try:
    o = json.load(open(sys.argv[4]))["claudeAiOauth"]
    toks += [o[k] for k in ("accessToken", "refreshToken") if isinstance(o.get(k), str) and o[k]]
except Exception: pass
lines = open(sys.argv[1], encoding="utf-8", errors="replace").read().rstrip("\n").split("\n")[-int(sys.argv[2]):]
print("\n".join(l for l in lines if l and not any(t in l for t in toks)))
PYEOF
}
show_call_errors() {   # each isolated call's own error output, last 5 lines, before the work folder goes
  local f
  for f in "$work"/*.err; do
    [ -s "$f" ] && [ -e "${f%.err}.failed" ] || continue   # only a call whose claude exited non-zero
    echo "vet: ${f##*/} said:" >&2; safe_tail "$f" 5
    rm -f "${f%.err}.failed"   # printed once; a retry that fails again marks it again
  done
}
die() {
  local m="$*"
  if [ "${credcopy:-no}" = yes ] && [ -s "${credtokens:-}" ]; then
    m=$(printf '%s' "$m" | python3 -c 'import sys
m = sys.stdin.read()
toks = open(sys.argv[1]).read().split("\n")
try:
    import json
    o = json.load(open(sys.argv[2]))["claudeAiOauth"]
    toks += [o.get("accessToken"), o.get("refreshToken")]
except Exception:
    pass
for t in toks:
    if isinstance(t, str) and t: m = m.replace(t, "[login]")
print(m)' "$credtokens" "${reader:-/nonexistent}/.credentials.json")
    login_scan || m="$m (files holding your login's secrets were removed)"
  fi
  echo "vet: $m" >&2; exit 1
}
plugin_version() { python3 -c 'import json,sys
for f in (".claude-plugin/plugin.json", "plugin.json", "package.json"):
    try: print(json.load(open(sys.argv[1] + "/" + f))["version"]); break
    except Exception: pass' "$1"; }

# part1_section DOSSIER COMMIT OUTFILE: tools/part1's "## What it adds" section, written to OUTFILE
part1_section() {
  if [ -n "$2" ]; then
    python3 "$nb/tools/part1" "$1" --commit "$2" >"$3" 2>"$work/part1.err"
  else
    python3 "$nb/tools/part1" "$1" >"$3" 2>"$work/part1.err"
  fi || { cat "$work/part1.err" >&2; die "part 1 could not be rendered"; }
}

if [ "${1:-}" = --check ]; then
  [ $# -eq 3 ] || usage
  report=$2 target=$3
  [ -f "$report" ] || die "no report at $report"
  [ -d "$target" ] || die "$target is not a folder"
  want=$(plugin_version "$target")
  [ -n "$want" ] || die "no version in $target's plugin.json"
  # the header line tools/vet writes: `DATE` · neckbeard X · <name or [name](url)> VERSION[ @ `commit`], where commit is a sha, "<sha> + uncommitted changes" or a release tag
  got=$(python3 -c 'import re,sys
for line in open(sys.argv[1], encoding="utf-8"):
    m = re.match(r"^`\d{4}-\d{2}-\d{2}` · neckbeard \S+ · (?:\[[^\]]+\]\([^)]+\)|\S+) (\S+)(?: @ |\s*$)", line)
    if m: print(m.group(1)); break' "$report")
  [ -n "$got" ] || die "$report has no header line naming a version"
  [ "$got" = "$want" ] || die "$report vets $got, but $target is $want: rebuild it (see examples/README.md)"
  echo "vet: $report is current ($want)"
  exit 0
fi
[ $# -ge 2 ] || usage
target=$1 out=$2 out_given=$2; shift 2
judge=auto model=${NECKBEARD_MODEL:-sonnet} repo="" note="" facts=no judgeflags=no readerdir="" releasetag=""
while [ $# -gt 0 ]; do case $1 in
  --judge) [ $# -ge 2 ] || usage; case $2 in reader|own) judge=$2 ;; *) usage ;; esac; judgeflags=yes; shift 2 ;;
  --model) [ $# -ge 2 ] || usage; model=$2; judgeflags=yes; shift 2 ;;
  --repo) [ $# -ge 2 ] || usage; case $2 in https://github.com/*/*) repo=${2%/} ;; *) usage ;; esac; shift 2 ;;
  --note) [ $# -ge 2 ] || usage; note=$2; judgeflags=yes; shift 2 ;;
  --units) judgeflags=yes; shift ;;   # a no-op: the units path is the default
  --reader) [ $# -ge 2 ] && [ -n "$2" ] || usage; readerdir=$2; judgeflags=yes; shift 2 ;;
  --release-tag) [ $# -ge 2 ] && [ -n "$2" ] || usage; case $2 in *[!A-Za-z0-9._-]*) usage ;; esac; releasetag=$2; shift 2 ;;   # a plain tag name: it goes into a public header line
  --facts) facts=yes; shift ;;
  *) usage ;;
esac; done
[ "$facts" = no ] || [ "$judgeflags" = no ] || usage
[ -z "$releasetag" ] || [ "$facts" = yes ] || usage

nb=$(cd "$(dirname "$0")/.." && pwd -P)
[ -d "$target" ] || die "$target is not a folder"
target=$(cd "$target" && pwd -P)
mkdir -p "$(dirname "$out")" || die "can't make the folder for $out"
out=$(cd "$(dirname "$out")" && pwd -P)/$(basename "$out")
command -v python3 >/dev/null || die "no python3 on PATH"

default_reader=$(cd "$nb/examples/reader" && pwd -P)
[ -z "$readerdir" ] || [ -d "$readerdir" ] || die "--reader $readerdir is not a folder"
[ -z "$readerdir" ] && readerdir=$default_reader || readerdir=$(cd "$readerdir" && pwd -P)
label="the sample reader" is_default=yes
[ "$readerdir" = "$default_reader" ] || { label=$(basename "$readerdir") is_default=no; }   # not by name: a folder may be called "the sample reader"

# 1. a throwaway reader and an empty project, removed however this exits
work=$(mktemp -d "${TMPDIR:-/tmp}/neckbeard-vet.XXXXXX") || die "mktemp failed"
trap 'rm -rf "$work"' EXIT
reader=$work/reader project=$work/project
if [ "$facts" = yes ]; then
  mkdir "$reader" "$project" || die "couldn't make the empty config folder"
else
  cp -R "$readerdir" "$reader" && mkdir "$project" || die "couldn't copy the reader ($label)"
fi
reader=$(cd "$reader" && pwd -P) project=$(cd "$project" && pwd -P)

# 2. the dossier
dossier=$project/dossier.json
# its note about the dossier holding your rules is moot here: the dossier is deleted on exit
CLAUDE_CONFIG_DIR=$reader python3 "$nb/skills/neckbeard/inventory.py" "$target" --project-dir "$project" --out "$dossier" >"$work/inventory.log" 2>&1 ||
  { cat "$work/inventory.log" >&2; die "the inventory failed"; }
if [ "$facts" = yes ]; then
  # --facts reads no reader: the rule list must be empty
  python3 - "$dossier" <<'EOF' || die "the dossier read rules, and a facts report must read none"
import json, sys
rules = json.load(open(sys.argv[1])).get("current_rules", {}).get("items", [])
if rules:
    print("vet: the dossier read: " + ", ".join(r.get("path") or "?" for r in rules), file=sys.stderr)
    sys.exit(1)
EOF
else
python3 - "$dossier" "$reader" <<'EOF'
import json, os, sys
rules = json.load(open(sys.argv[1])).get("current_rules", {}).get("items", [])
paths = [r.get("path") or "" for r in rules]
root = os.path.realpath(sys.argv[2]) + os.sep
if not paths:
    sys.exit(3)   # no rule files: the facts report, below
sys.exit(0 if all(os.path.realpath(p).startswith(root) for p in paths) else 1)
EOF
  case $? in
    0) ;;
    3) # nothing to vet against: start again as --facts, with a fresh empty folder and a fresh inventory
       echo "vet: $label has no rule files, so there is no verdict to give; writing the facts report instead" >&2
       rm -rf "$work"; trap - EXIT
       exec "$0" "$target" "$out_given" --facts ${repo:+--repo "$repo"} ;;
    *) die "the dossier read rules from outside $label" ;;
  esac
  command -v claude >/dev/null || die "no claude on PATH"
  # the baseline: what the verdict is relative to, from the rule files the inventory listed
  baseline_file=$work/baseline.md
  read -r nfiles nbytes fingerprint < <(python3 - "$dossier" "$reader" "$label" "$baseline_file" <<'EOF'
import hashlib, json, os, sys
rules = json.load(open(sys.argv[1])).get("current_rules", {}).get("items", [])
root = os.path.realpath(sys.argv[2])
rows = sorted((os.path.relpath(os.path.realpath(r["path"]), root), r["path"]) for r in rules)
h, total = hashlib.sha256(), 0
for rel, path in rows:
    data = open(path, "rb").read()
    total += len(data)
    h.update(rel.encode("utf-8") + b"\0" + data + b"\0")
fp = h.hexdigest()[:12]
with open(sys.argv[4], "w", encoding="utf-8") as f:
    f.write(f"\nBaseline: {sys.argv[3]} \u00b7 {len(rows)} rule files \u00b7 {total} bytes \u00b7 sha256 {fp}\n\n<details><summary>Rule files</summary>\n\n")
    f.write("".join(f"- `{rel}`\n" for rel, _ in rows) + "\n</details>\n")
print(len(rows), total, fp)
EOF
) || die "couldn't compute the baseline"
fi

# 3. the judge (--facts has none)
# On Linux the login lives in the config folder's login file, so the default reader gets a copy of the caller's for this
# run (mode 600, removed with the work folder). A --reader folder never does: its settings.json hooks run.
credcopy=no credsum="" credtokens=$work/login.tokens login_why=""
copy_login() {   # sets login_why and returns 1 when there is nothing to copy
  [ "$is_default" = yes ] || { login_why="a --reader folder never gets your login"; return 1; }
  [ "$(uname -s)" = Linux ] || { login_why="reader mode logs in only on Linux"; return 1; }
  local f=${CLAUDE_CONFIG_DIR:-${HOME:-}/.claude}/.credentials.json
  [ -f "$f" ] || { login_why="no login file in your config folder"; return 1; }
  python3 - "$f" "$credtokens" <<'PYEOF'
import json, sys, time
try:
    o = json.load(open(sys.argv[1]))["claudeAiOauth"]
    exp = int(o["expiresAt"]) / 1000.0
    toks = [o[k] for k in ("accessToken", "refreshToken") if isinstance(o.get(k), str) and o[k]]
except Exception:
    sys.exit(3)
open(sys.argv[2], "w").write("\n".join(toks))
sys.exit(0 if exp > time.time() + 3600 else 4)
PYEOF
  case $? in
    0) ;;
    4) rm -f "$credtokens"; login_why="your login is due to refresh within the hour"; return 1 ;;
    *) rm -f "$credtokens"; login_why="your login file couldn't be read"; return 1 ;;
  esac
  (umask 077; cp "$f" "$reader/.credentials.json") && chmod 600 "$reader/.credentials.json" || { login_why="your login file couldn't be read"; return 1; }
  credcopy=yes credsum=$(cksum <"$reader/.credentials.json")
}
if [ "$facts" = no ] && { [ "$judge" = auto ] || [ "$judge" = reader ]; }; then
  forced=no; [ "$judge" = reader ] && forced=yes
  copy_login || true
  probe_out=$work/probe.out
  (cd "$project" && CLAUDE_CONFIG_DIR=$reader timeout 120 claude -p --model "$model" "Reply with the single word ok") >"$probe_out" 2>&1
  if grep -qx ok "$probe_out"; then
    judge=reader
  elif [ "$forced" = yes ]; then   # you asked for the reader, so you get the reader or a reason, never the own judge
    [ "$credcopy" != yes ] || [ "$(cksum <"$reader/.credentials.json" 2>/dev/null)" = "$credsum" ] || echo "vet: the probe rewrote its login file, so you may need to log in again" >&2
    [ "$credcopy" != yes ] || login_why="your login didn't work as the reader"
    echo "vet: --judge reader can't log in with $label as its config folder here ($login_why); run without --judge to fall back, or with --judge own" >&2
    safe_tail "$probe_out" 1
    exit 1
  else
    judge=own
    if [ "$credcopy" = yes ]; then
      [ "$(cksum <"$reader/.credentials.json" 2>/dev/null)" = "$credsum" ] || echo "vet: the probe rewrote its login file, so you may need to log in again" >&2
      login_why="your login didn't work as the reader"; rm -f "$reader/.credentials.json" "$credtokens"; credcopy=no
    fi
    echo "vet: the judge can't log in with $label as its config folder here ($login_why), so it runs with your own config and is told to ignore it" >&2
  fi
fi
if [ "$facts" = no ]; then   # the report names the judge that ran, beside the Baseline line
  if [ "$judge" = own ]; then judge_says="your own config, told to ignore it"
  elif [ "$is_default" = yes ]; then judge_says="the sample reader's config"
  else judge_says="$label's config"; fi
  python3 - "$baseline_file" "Judge: $judge_says" <<'PYEOF' || die "couldn't name the judge in the baseline"
import sys
lines = open(sys.argv[1], encoding="utf-8").read().split("\n")
i = next(i for i, l in enumerate(lines) if l.startswith("Baseline: "))
lines[i + 1:i + 1] = ["", sys.argv[2]]
open(sys.argv[1], "w", encoding="utf-8").write("\n".join(lines))
PYEOF
fi
version=$(plugin_version "$target")
commit=$(git -C "$target" rev-parse --short HEAD 2>/dev/null || true)
# the files read are the working tree's: say so when a tracked file differs from HEAD, and name the tag under --release-tag
if [ -n "$releasetag" ]; then commit=$releasetag
elif [ -n "$commit" ] && [ -n "$(git -C "$target" status --porcelain --untracked-files=no 2>/dev/null)" ]; then commit="$commit + uncommitted changes"; fi
remote=$(git -C "$target" remote get-url origin 2>/dev/null | sed -E 's#^git@github\.com:#https://github.com/#; s#\.git$##' || true)
case $remote in https://github.com/*) ;; *) remote="" ;; esac
[ -n "$repo" ] && remote=${repo%.git}
nbversion=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["version"])' "$nb/.claude-plugin/plugin.json")
name=$(basename "$target")
[ -n "$remote" ] && name=${remote#https://github.com/}
source=$name
[ -n "$remote" ] && source="[$name]($remote)"
# header_lines: the title line, then the header line, for both the judged report and --facts (vet --check reads the second)
header_lines() {
  echo "# 🔍 ${name##*/}${version:+ $version} · $title_tail"
  echo "\`$(date +%Y-%m-%d)\` · neckbeard $nbversion · $source${version:+ $version}${commit:+ @ \`$commit\`}"
}
if [ "$facts" = yes ]; then
  title_tail="what it adds"
  {
    header_lines | sed -n 1p
    echo
    header_lines | sed -n 2p
    echo
    if [ -n "$commit" ]; then python3 "$nb/tools/part1" "$dossier" --commit "$commit"; else python3 "$nb/tools/part1" "$dossier"; fi 2>"$work/part1.err" ||
      { cat "$work/part1.err" >&2; die "part 1 could not be rendered"; }
    echo
    echo "No reader's rules were read: this report lists facts only and carries no verdict."
  } >"$work/facts.md" || die "part 1 could not be rendered"
  # the badge for it, as stdout's last line: the label, the target's version and how much of it was read, the word from
  # tools/part1 --read-state on the dossier (whoever's limit a gap is, it counts). Worked out before OUT is written, so a failure leaves no report.
  read_word=$(python3 "$nb/tools/part1" --read-state "$dossier" 2>"$work/part1.err") || { cat "$work/part1.err" >&2; die "couldn't write the badge line"; }
  badge=$(python3 - "$read_word" "$version" "$out_given" "$nb/tools/badge-logo" <<'EOF'
import sys
from urllib.parse import quote
state, version, link, logo_file = sys.argv[1:]
colour = {"read in full": "brightgreen", "partly read": "yellow", "something unread": "red"}.get(state)   # the word comes from tools/part1 --read-state
if colour is None:
    sys.exit("tools/part1 --read-state printed a word the badge does not know: " + state)
message = (version + " \u00b7 " if version else "") + state
shield = quote(message.replace("-", "--").replace("_", "__"), safe="")   # shields.io: "-" and "_" are doubled, the rest percent-encoded
alt = message.replace("]", "\\]")
logo = open(logo_file, encoding="utf-8").read().strip()
link = link.replace(" ", "%20").replace("(", "%28").replace(")", "%29")
print(f"[![neckbeard: {alt}](https://img.shields.io/badge/neckbeard-{shield}-{colour}?logo={logo})]({link})")
EOF
  ) || die "couldn't write the badge line"
  # the local-path check runs before OUT is written, so a report that names one never lands there
  for p in "$work" "$(cd "$work" && pwd -P)" "$target" "${HOME:-/nonexistent}"; do
    [ "$p" = / ] && continue
    grep -qF -- "$p" "$work/facts.md" && die "the facts report names a local path ($p), so $out was not written"
  done
  mv "$work/facts.md" "$out"
  echo "vet: facts report $out" >&2
  printf '%s\n' "$badge"
  exit 0
fi
title_tail="vetted against $label"
title=$(header_lines | sed -n 1p) header=$(header_lines | sed -n 2p)
if [ "$is_default" = yes ]; then
  reader_noun="the sample reader" reader_cite="examples/reader/... paths, never by the folder above"
  verdict_text="Verdict is relative to the [sample reader](https://github.com/jerrydboonstra/neckbeard/tree/main/examples/reader), not a judgment of the plugin's quality. Reproduce: see [examples/README.md](https://github.com/jerrydboonstra/neckbeard/blob/main/examples/README.md)."
else
  reader_noun="the reader $label" reader_cite="their path inside the reader (for example rules/safety.md), never by the folder above"
  verdict_text="Verdict is relative to $label's $nfiles rule files (fingerprint $fingerprint), not a judgment of the plugin's quality."
fi
stem=${out%.md}
unitsf=$stem.units.json answers=$stem.answers.json cands=$stem.candidates.json confs=$stem.confirmations.json confirmed=$stem.confirmed.json verdictf=$stem.verdict.json prose=$stem.prose.json
rm -f "$out" "$answers" "$cands" "$confs" "$confirmed" "$verdictf" "$prose" "$stem".finds-*.json
python3 "$nb/tools/rule-units" "$dossier" "$unitsf" >&2 || die "rule-units failed"
test_text=$(cat "$nb/tools/vet-conflict-test.md")
ucfg=()
[ "$judge" = reader ] && ucfg=(env CLAUDE_CONFIG_DIR="$reader")
usage_log=$work/usage.log
# an isolated judge call: PROMPT-FILE in, its text answer on stdout; its cost and time go to the usage log
call() { # call TOOLS PROMPT-FILE
  local rc
  rm -f "${2%.md}.failed"
  (cd "$project" && ${ucfg[@]+"${ucfg[@]}"} claude -p --model "$model" --allowedTools "$1" --output-format json < "$2") >"$2.json"
  rc=$?
  [ "$rc" = 0 ] || { : >"${2%.md}.failed"; return "$rc"; }   # its own error is already in the call's .err file
  python3 -c 'import json,sys
r = json.load(sys.stdin)
print(r.get("result", ""))
open(sys.argv[1], "a").write("%s %s\n" % (r.get("total_cost_usd", 0), r.get("duration_ms", 0)))' "$usage_log" <"$2.json"
}
# 3a. three find passes, side by side, each writing its own candidates
for i in 1 2 3; do
  python3 -c 'import sys
print(open(sys.argv[1], encoding="utf-8").read().format(units=sys.argv[2], dossier=sys.argv[3], finds=sys.argv[4], test=sys.argv[5]))' \
    "$nb/tools/vet-find.md" "$unitsf" "$dossier" "$stem.finds-$i.json" "$test_text" >"$work/find-$i.md"
  call Read,Write,Glob,Grep "$work/find-$i.md" >"$work/find-$i.out" 2>"$work/find-$i.err" &
done
wait
show_call_errors
for i in 1 2 3; do [ -s "$stem.finds-$i.json" ] || die "find pass $i wrote no candidates ($(head -c 300 "$work/find-$i.out" "$work/find-$i.err"))"; done
python3 "$nb/tools/units-confirm" pool "$unitsf" "$dossier" "$cands" "$stem".finds-[123].json >&2 || die "pooling the candidates failed"
# 3b. each candidate confirmed alone: it sees the reader rule (with its file and heading), the sentence and the written test, and nothing else
python3 -c 'import json,sys
for c in json.load(open(sys.argv[1]))["candidates"]:
    open("%s/confirm-%s.rule" % (sys.argv[2], c["cid"]), "w").write(c["reader_rule"])
    open("%s/confirm-%s.label" % (sys.argv[2], c["cid"]), "w").write(c["reader_rule"].split(": ", 1)[0])
    open("%s/confirm-%s.heading" % (sys.argv[2], c["cid"]), "w").write(c.get("heading", ""))
    open("%s/confirm-%s.sentence" % (sys.argv[2], c["cid"]), "w").write(c["quote"])' "$cands" "$work"
for f in "$work"/confirm-*.rule; do
  [ -e "$f" ] || break
  cid=${f##*/confirm-}; cid=${cid%.rule}
  python3 -c 'import sys
print(open(sys.argv[1], encoding="utf-8").read().format(rule=open(sys.argv[2]).read(), sentence=open(sys.argv[3]).read(), test=sys.argv[4], label=open(sys.argv[5]).read(), heading=open(sys.argv[6]).read()))' \
    "$nb/tools/vet-confirm.md" "$f" "$work/confirm-$cid.sentence" "$test_text" "$work/confirm-$cid.label" "$work/confirm-$cid.heading" >"$work/confirm-$cid.md"
  call "" "$work/confirm-$cid.md" >"$work/confirm-$cid.out" 2>"$work/confirm-$cid.err" &
done
wait
show_call_errors
# a confirm call that answered with no JSON (a refusal, a hiccup) gets one more try, alone
for f in "$work"/confirm-*.md; do
  [ -e "$f" ] || break
  cid=${f##*/confirm-}; cid=${cid%.md}
  grep -q '"conflict"' "$work/confirm-$cid.out" || call "" "$f" >"$work/confirm-$cid.out" 2>"$work/confirm-$cid.err"
done
show_call_errors   # a retry that failed again
python3 - "$cands" "$work" "$confs" "$confirmed" 2>"$work/confirm-parse.err" <<'PYEOF2' || { safe_tail "$work/confirm-parse.err" 5; die "a confirm call gave no usable answer"; }
import json, re, sys
cands = json.load(open(sys.argv[1]))["candidates"]
confs, kept = [], []
for c in cands:
    text = ""
    try:
        text = open(f"{sys.argv[2]}/confirm-{c['cid']}.out", encoding="utf-8").read()
        a = json.loads(re.search(r"\{.*\}", text, re.S).group(0))
        assert isinstance(a["conflict"], bool)
        assert isinstance(a.get("hard_stop"), bool) or not a["conflict"]   # a confirmed conflict says whether its rule is a hard stop
    except Exception:
        print(f"vet: the confirm call for {c['cid']} gave no usable answer: {text[:200]!r}", file=sys.stderr)
        sys.exit(1)
    confs.append({"cid": c["cid"], "conflict": a["conflict"], "hard_stop": a.get("hard_stop") is True, "why": str(a.get("why", ""))})
    if a["conflict"]:
        kept.append({**c, "hard_stop": a["hard_stop"], "why": str(a.get("why", ""))})
json.dump({"confirmations": confs}, open(sys.argv[3], "w"), indent=1)
json.dump({"confirmed": kept}, open(sys.argv[4], "w"), indent=1)
print(f"vet: units: {len(kept)} of {len(cands)} candidates confirmed", file=sys.stderr)
PYEOF2
cat "$work/confirm-parse.err" >&2   # the python step's one summary line
# 3c. the answering judge: one call that answers every unit
python3 -c 'import sys
print(open(sys.argv[1], encoding="utf-8").read().format(units=sys.argv[2], dossier=sys.argv[3], answers=sys.argv[4]))' "$nb/tools/vet-units.md" "$unitsf" "$dossier" "$answers" >"$work/answer.md" || die "couldn't write the answering prompt"
call Read,Write,Glob,Grep "$work/answer.md" >"$work/answer.out" 2>"$work/answer.err" || { show_call_errors; echo "vet: the answering judge said:" >&2; safe_tail "$work/answer.md.json" 5; die "the answering judge exited non-zero"; }
show_call_errors
login_scan || die "the judge's output held your login's secrets, so no report was written"
[ -s "$answers" ] || die "the answering judge wrote no answers to $answers ($(head -c 300 "$work/answer.out" "$work/answer.err"))"
# whatever the judge wrote under conflicts, only the confirmed ones count: put them in, with the file each is held in and whether its rule is a hard stop
python3 "$nb/tools/units-confirm" merge "$cands" "$confs" "$answers" >/dev/null || die "couldn't put the confirmed conflicts into the answers"
# 3d. the verdict and counts, by code
computed=$(python3 "$nb/tools/units-verdict" "$unitsf" "$answers") || { echo "$computed" >&2; die "the judge's answers were refused"; }
echo "vet: units: $computed" >&2
python3 "$nb/tools/units-verdict" "$unitsf" "$answers" --json >"$verdictf" || die "couldn't write the verdict records"
# 3e. the prose judge: only the Why paragraph, the Do this steps and the rules patch
python3 -c 'import sys
print(open(sys.argv[1], encoding="utf-8").read().format(reader_noun=sys.argv[2], reader_cite=sys.argv[3], name=sys.argv[4], target=sys.argv[5], dossier=sys.argv[6], verdict_json=open(sys.argv[7], encoding="utf-8").read(), prose=sys.argv[8]))' \
  "$nb/tools/vet-prose.md" "$reader_noun" "$reader_cite" "$name${version:+ $version}" "$target" "$dossier" "$verdictf" "$prose" >"$work/prose.md" || die "couldn't write the prose prompt"
call Read,Write,Glob,Grep "$work/prose.md" >"$work/prose.out" 2>"$work/prose.err"
prose_rc=$?
if [ "$credcopy" = yes ]; then
  [ "$(cksum <"$reader/.credentials.json" 2>/dev/null)" = "$credsum" ] || echo "vet: the judge rewrote its login file, so you may need to log in again" >&2
  login_scan || die "the judge's output held your login's secrets, so no report was written"
fi
[ "$prose_rc" = 0 ] || { show_call_errors; echo "vet: the prose judge said:" >&2; safe_tail "$work/prose.md.json" 5; }
rm -f "$credtokens"
[ "$prose_rc" = 0 ] || die "the prose judge exited non-zero"
show_call_errors
[ -s "$prose" ] || die "the prose judge wrote no prose to $prose"
python3 - "$usage_log" "$SECONDS" <<'PYEOF2' >&2
import sys
try: rows = [l.split() for l in open(sys.argv[1]) if l.strip()]
except OSError: rows = []
print(f"vet: units cost: {len(rows)} calls, ${sum(float(r[0]) for r in rows):.2f}, {sum(int(float(r[1])) for r in rows) // 1000} s of call time; whole vet {sys.argv[2]} s")
PYEOF2

# 4. the report: title, header, the fit strip and cards, then part 1
python3 "$nb/tools/fit" "$verdictf" "$prose" --label "$label" --target "${name##*/}" --verdict-text "${note:+$note }$verdict_text" --baseline "$baseline_file" >"$work/fit.md" || die "the fit report could not be drawn from $verdictf and $prose"
part1_section "$dossier" "$commit" "$work/part1.md"
{ printf '%s\n\n%s\n\n' "$title" "$header"; cat "$work/fit.md"; printf '\n'; cat "$work/part1.md"; } >"$out"
login_scan || die "the report held your login's secrets, so no report was written"
for p in "$work" "$(cd "$work" && pwd -P)" "$target" "$readerdir" "${HOME:-/nonexistent}"; do
  [ "$p" = / ] && continue
  grep -qF -- "$p" "$out" && { rm -f "$out"; die "$out names a local path ($p); fix it by hand or rerun"; }
done
echo "vet: report $out (judge: $judge)"
