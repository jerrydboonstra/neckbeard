#!/usr/bin/env python3
"""summary DOSSIER: print the "How it affects you" table, five rows computed by code from the dossier, each a judgement colour
(🟩🟨🟧🟥), a name and one line. No model call. Same style as tools/part1: reads only the dossier's `target`, prints Markdown,
and two runs on one dossier are byte-identical.

Under the table, one line each for Leaves state (a link to the "State it may leave" card) and Read completeness (the sections not read in full), only when there is something to say, then one collapsed card, "How the colours are set", holding the rules. It prints no layer heading: the report that uses the table writes its own. The Cost bands and the command-word lists live in one table,
RULES, and the footer prints them from it, so changing one changes the colour and the footer together; the other footer rules are written
by hand and kept in step with the code by hand.
A row's rules are checked top to bottom: the first that matches wins. A row whose input sections (target.read_status) are not all
read in full is never 🟩: a 🟩 outcome becomes 🟨. A section that is not-applicable counts as read in full, as in tools/part1.

  Cost                the size a plugin adds to every session: skill and agent descriptions, rule files that load every
                      session, and hook-injected text (a built-at-run-time hook's "at least N bytes" lower bound). When
                      hooks_reach_subagents is true the hook text alone counts twice (it enters every subagent too); anything
                      else counts once. Size is the dossier's figure (bytes, or characters where the inventory fell back).
  Reach               🟥 a hook and hooks_reach_subagents true; 🟨 a hook, a Claude Code mod or a rule file; 🟩 neither.
  Leaves state        🟧 files that may write state; 🟨 nothing found but the scan was not whole; 🟩 nothing found, full scan.
  Live surface        🟥 ssh, mosh, telnet, rsh or rlogin as a command word of a hook or MCP command; 🟧 any MCP server, any Claude
                      Code mod, or a hook running curl, wget or nc or holding an http(s) URL; 🟨 any hook command; 🟩 none.
  Read completeness   tools/part1's overall read state, as its colour.

A command word is the first word of each piece of the command, cut at newlines and at `|`, `&&`, `||`, `;` and `&` outside quotes, with
leading NAME=value words skipped (tools/part1's words()), compared by basename; an MCP server's command is compared by its first
word and each of its args whole, by basename. Inline code (`bash -c`, `node -e`), hook script bodies and commands behind a wrapper (sudo, timeout, command,
nohup, exec, xargs, subshells, `$( )`, backticks) are not searched. A hook command over tools/part1's MAX_COMMAND characters is too long to
read and makes Live surface 🟧. A size that is not a whole number counts as an unread input, and so does a wrong-typed mcp_servers.servers, hooks.mods or
persistence_candidates; a wrong-typed skills, agents, rule_files or injected_content list counts as 0.
A refused skill, agent or rule entry counts 0 toward Cost.
A dossier with no read_status exits 2."""
import importlib.machinery, importlib.util, json, os, re, shlex, sys

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
from cards import card


def _load(name):
    spec = importlib.util.spec_from_loader(name, importlib.machinery.SourceFileLoader(name, os.path.join(HERE, name)))
    m = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(m)
    return m


part1 = _load("part1")

G, Y, O, R = "\U0001F7E9", "\U0001F7E8", "\U0001F7E7", "\U0001F7E5"
ROW_NAMES = ["Cost", "Reach", "Leaves state", "Live surface", "Read completeness"]

# The rules table: every threshold and word list the colours and the footer use.
RULES = {
    "cost_bands": [2000, 8000, 32000],   # 🟩 under the first; 🟨 up to the second; 🟧 up to the third; 🟥 from the third on
    "remote_shell": ["ssh", "mosh", "telnet", "rsh", "rlogin"],
    "network": ["curl", "wget", "nc"],
}
READ_COLOUR = {"read in full": G, "partly read": Y, "something unread": R}
URL = re.compile(r"https?://")
SEPARATORS = re.compile(r"\|\||&&|[|;&]")


def n(x):
    return f"{x:,}"


def many(count, noun):
    """'1 file', '2 files'."""
    return f"{n(count)} {noun}" + ("" if count == 1 else "s")


def as_list(v):
    return v if isinstance(v, list) else []


def size_of(v):
    """A size from the dossier: a whole number that is not negative (a bool is not one), else None."""
    return v if isinstance(v, int) and not isinstance(v, bool) and v >= 0 else None


def command_words(command):
    """The first word of each piece of a command, as a basename. The command is cut at newlines, then at | && || ; and & outside
    quotes (a piece the shell would not cut, such as 'cd /app && x' inside quotes, stays whole); a line shlex cannot parse is cut
    at those characters wherever they stand. Each piece goes through tools/part1's words()."""
    out = []
    for line in command.split("\n") if isinstance(command, str) else []:
        try:
            lex = shlex.shlex(line, posix=True, punctuation_chars=True)
            lex.whitespace_split = True
            toks, groups = list(lex), [[]]
            for t in toks:
                if t and set(t) <= set("|&;"):
                    groups.append([])
                else:
                    groups[-1].append(t)
            pieces = [shlex.join(g) for g in groups if g]
        except ValueError:
            pieces = SEPARATORS.split(line)
        for piece in pieces:
            w = part1.words(piece)
            if w:
                out.append(os.path.basename(w[0]))
    return out


def too_long(command):
    return isinstance(command, str) and len(command) > part1.MAX_COMMAND


def hook_commands(hooks):
    ev = hooks.get("events")
    return [c["command"] for cmds in (ev.values() if isinstance(ev, dict) else []) for c in as_list(cmds)
            if isinstance(c, dict) and isinstance(c.get("command"), str)]


def finish(colour, line, states):
    """A row's colour, line and input states, after the never-green rule: a 🟩 whose inputs were not all read in full is 🟨, and
    any row not read in full says so, so a line never claims an absence nobody read."""
    if part1.read_state(states) == "read in full":
        return colour, line
    return (Y if colour == G else colour), f"{line} (not read in full)"


def cost(t, sec, hooks, hsec):
    states = [sec("skills")[0], sec("agents")[0], sec("rule_files")[0], hsec[0]]
    desc = lambda e: len(str(e.get("description") or "")) if isinstance(e, dict) and not e.get("refused") else 0
    skills = sum(desc(s) for s in as_list(t.get("skills")))
    agents = sum(desc(a) for a in as_list(t.get("agents")))
    rules = hook = 0
    for r in as_list(t.get("rule_files")):
        if isinstance(r, dict) and not r.get("refused") and r.get("bytes") is not None:
            if size_of(r["bytes"]) is None:
                states.append("failed")   # a size that is not a whole number is not a size
            else:
                rules += r["bytes"]
    inj = as_list(hooks.get("injected_content"))
    for i in inj:
        if isinstance(i, dict) and i.get("bytes") is not None:
            if size_of(i["bytes"]) is None:
                states.append("failed")
            else:
                hook += i["bytes"]
    twice = hooks.get("hooks_reach_subagents") is True
    total = skills + agents + rules + hook * (2 if twice else 1)
    b = RULES["cost_bands"]
    colour = G if total < b[0] else Y if total < b[1] else O if total < b[2] else R
    lower = any(isinstance(i, dict) and i.get("built_at_run_time") for i in inj)
    line = (f"adds {'at least ' if lower else ''}{n(total)} characters to every session, ~{n((total + 2) // 4)} tokens"
            f" ({n(skills)} skill descriptions, {n(agents)} agent descriptions, {n(rules)} rule files, {n(hook)} hook text"
            f"{', counted twice because hooks reach subagents' if twice and hook else ''})")
    return finish(colour, line, states)


def hook_present(hooks):
    """Whether the plugin has a hook: one is registered (a command, or a registration count above 0), or the events could not
    be read (has_hooks "unknown" or "partial", for instance a malformed event). A hooks file with no registration is no hook (a plugin whose only addition is a mod has such a file)."""
    reg = hooks.get("hook_registrations")
    if hook_commands(hooks) or (isinstance(reg, int) and not isinstance(reg, bool) and reg > 0):
        return True
    return hooks.get("has_hooks") in ("unknown", "partial") or (hooks.get("has_hooks") is True and reg is None)


def reach(t, sec, hooks):
    has_hook = hook_present(hooks)
    mods = bool(as_list(hooks.get("mods")))
    rules = bool(as_list(t.get("rule_files")))
    r = hooks.get("hooks_reach_subagents")
    states = [sec("hooks")[0], sec("rule_files")[0]]
    if "mods" in hooks and not isinstance(hooks["mods"], list):
        states.append("failed")
    if has_hook and r is True:
        colour, line = R, "a hook runs in every session and in every subagent too"
    elif has_hook or mods or rules:
        what = [w for w, on in (("a hook", has_hook), ("a Claude Code mod", mods), ("a rule file", rules)) if on]
        colour, line = Y, f"{', '.join(what)} in every main session" + (", subagent reach unknown" if has_hook and r is None else "")
    else:
        colour, line = G, "on demand only"
    return finish(colour, line, states)


def leaves(t, sec):
    pc = t.get("persistence_candidates")
    files = as_list(pc)
    states = [sec("persistence_candidates")[0]] + (["failed"] if pc is not None and not isinstance(pc, list) else [])
    if files:
        return O, f"{many(len(files), 'file')} that may write state"
    return finish(G, "nothing found", states)


def live(t, sec, hooks):
    cmds = hook_commands(hooks)
    mods = as_list(hooks.get("mods"))
    mcp = t.get("mcp_servers")
    states = [sec("hooks")[0], sec("mcp_servers")[0]]
    if isinstance(mcp, dict) and not isinstance(mcp.get("servers"), (list, type(None))) or mcp is not None and not isinstance(mcp, dict) \
            or "mods" in hooks and not isinstance(hooks["mods"], list):
        states.append("failed")
    servers = [s for s in as_list(mcp.get("servers")) if isinstance(s, dict)] if isinstance(mcp, dict) else []
    long_cmd = any(too_long(c) for c in cmds)
    hook_words = {w for c in cmds if not too_long(c) for w in command_words(c)}
    words = set(hook_words)
    for s in servers:
        args = s.get("args")
        if args is not None and not isinstance(args, list):
            states.append("failed")
        first = [] if too_long(s.get("command")) else command_words(s.get("command"))[:1]
        words |= {os.path.basename(str(a)) for a in [*first, *as_list(args)]}
    net = bool(hook_words & set(RULES["network"])) or any(URL.search(c) for c in cmds) or long_cmd
    if words & set(RULES["remote_shell"]):
        colour, line = R, "runs " + ", ".join(sorted(words & set(RULES["remote_shell"]))) + " (a remote shell)"
    elif servers or mods or net:
        what = [many(len(servers), "MCP server")] if servers else []
        what += [many(len(mods), "Claude Code mod")] if mods else []
        what += ["hook commands that may reach the network" + (" (one too long to read)" if long_cmd else "")] if net else []
        colour, line = O, ", ".join(what)
    elif cmds:
        colour, line = Y, f"{many(len(cmds), 'hook command')}, local scripts only"
    else:
        colour, line = G, "no hook commands, MCP servers or mods found"
    return finish(colour, line, states)


def safe(text, cap=200):
    """tools/part1's safe() (one line, paths cut, capped) with the read markers taken out, so no dossier text puts one in the card."""
    return re.sub("[\U0001F7E2\U0001F7E1\U0001F534]", "", part1.safe(text, cap=cap))


def footer():
    b = RULES["cost_bands"]
    return [
        "The colours follow written rules. Each is checked top to bottom, and the first match wins. A row whose input was not read in full is never 🟩.",
        "",
        f"- Cost: 🟩 under {n(b[0])}; 🟨 {n(b[0])} to {n(b[1] - 1)}; 🟧 {n(b[1])} to {n(b[2] - 1)}; 🟥 {n(b[2])} and over. "
        "Size counts skill and agent descriptions, rule files and hook-injected text, in the dossier's unit (bytes, or characters where the inventory fell back); "
        "text a hook builds at run time counts as at least its known size. Hook text counts twice when hooks reach subagents. An entry that was refused or has no usable size counts as 0.",
        "- Reach: 🟥 a hook and hooks reach subagents; 🟨 a hook, a Claude Code mod or a rule file (every main session); 🟩 neither (on demand only).",
        "- Leaves state: 🟧 one or more files that may write state; 🟨 nothing found but the scan was partial or failed; 🟩 nothing found by a full scan.",
        f"- Live surface: 🟥 a hook or MCP command runs {', '.join(RULES['remote_shell'])} (each a remote shell); "
        f"🟧 any MCP server, any Claude Code mod, a hook running {', '.join(RULES['network'])} or holding an http:// or https:// URL, or a hook command too long to read; 🟨 any hook command; 🟩 none. "
        "A command word is the first word of each piece, cut at newlines and at | && || ; & outside quotes, after NAME=value words, by basename; an MCP server's command is compared by its first word and each of its args whole, by basename. "
        "The scan does not search inline code (bash -c, node -e), hook script bodies, or commands behind a wrapper (sudo, timeout, command, nohup, exec, xargs, ( ), { }, !, $( ) or backticks).",
        "- Read completeness: 🟩 read in full; 🟨 partly read; 🟥 something unread.",
    ]


def render(d):
    t = d["target"]
    sec = part1.sec_of(t["read_status"])
    hooks = t.get("hooks") if isinstance(t.get("hooks"), dict) else {}
    hsec = part1.hooks_sec(sec, hooks)
    state = part1.overall_read_state(t)
    result = [("Cost", *cost(t, sec, hooks, hsec)), ("Reach", *reach(t, sec, hooks)), ("Leaves state", *leaves(t, sec)),
              ("Live surface", *live(t, sec, hooks)), ("Read completeness", READ_COLOUR[state], state)]
    out = ["| | Row | In short |", "|---|---|---|"]
    out += [f"| {c} | {name} | {line} |" for name, c, line in result]
    notes = []
    if as_list(t.get("persistence_candidates")):
        notes.append("- **Leaves state**: the files are listed in the \"State it may leave\" card under [What it adds](#what-it-adds).")
    state_of = lambda v: v.get("state") if isinstance(v, dict) else "failed"
    unread = sorted(k for k, v in t["read_status"].items() if state_of(v) not in ("read", "not-applicable"))
    if unread:
        notes.append("- **Read completeness**: not read in full: " + ", ".join(f"{safe(k)} ({safe(state_of(t['read_status'][k]))})" for k in unread) + ".")
    out += ([""] + notes if notes else []) + [""] + card("", "How the colours are set", "", footer()) + [""]
    return "\n".join(out)


def main(argv):
    if len(argv) != 1:
        print("usage: summary DOSSIER", file=sys.stderr)
        return 2
    try:
        d = json.load(open(argv[0], encoding="utf-8"))
        t = d["target"]
    except (OSError, ValueError, KeyError, TypeError) as e:
        print(f"summary: cannot read a dossier from {argv[0]}: {e}", file=sys.stderr)
        return 2
    if not isinstance(t, dict) or not isinstance(t.get("read_status"), dict) or not t["read_status"]:
        print("summary: dossier has no read_status; rerun inventory.py", file=sys.stderr)
        return 2
    try:
        text = render(d)
    except Exception as e:   # a dossier shape this tool does not know: fail rather than print a colour that may be wrong
        print(f"summary: could not render this dossier ({type(e).__name__}: {part1.safe(e, cap=200)})", file=sys.stderr)
        return 2
    sys.stdout.write(text)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
