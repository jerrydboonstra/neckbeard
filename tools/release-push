#!/usr/bin/env bash
# release-push: the push half of `make release`, after its checks. Env: VERSION, REMOTES (GitHub's remote first, then any
# mirrors; `make` sets both). In order:
#   1. refuse an unbumped version (v$VERSION exists on an older commit) before anything is pushed
#   2. push HEAD to GitHub alone as release/v$VERSION, fast-forward only, never force (CI runs on release/** pushes)
#   3. wait for CI on that exact commit (tools/ci-wait.sh)
#   4. only then push main to GitHub (fast-forward only), create the tag (if absent), push main and the tag to every
#      remote, and delete the release branch on GitHub (a failed delete is a warning)
# A failed CI leaves public main, the tag and the mirrors untouched; release/v$VERSION holds the commit, so the fix goes on
# top of it and the release runs again.
set -u
version=${VERSION:?release-push: VERSION is not set}
remotes=${REMOTES:?release-push: REMOTES is not set}
tag=v$version
branch=release/$tag
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
first=${remotes%% *}
[ "$(git branch --show-current)" = main ] || { echo "release: not on main"; exit 1; }
sha=$(git rev-parse HEAD)
if git rev-parse -q --verify "refs/tags/$tag" >/dev/null && [ "$(git rev-parse "$tag^{commit}")" != "$sha" ]; then
  echo "release: $tag already exists on an older commit; bump the version (plugin.json and marketplace.json), then release again"
  exit 1
fi
echo "== $first: $branch, ahead of CI"
git push "$first" "$sha:refs/heads/$branch" || {
  echo "release: $first refused $branch, which holds a commit this release doesn't build on. Never force from here. Fix on top of that commit, or delete the stale branch by hand (git push $first :refs/heads/$branch), then release again. Main is untouched."
  exit 1
}
bash "$here/ci-wait.sh" "$sha" || { echo "release: CI did not pass on ${sha:0:7}; public main untouched, no tag made, no other remote pushed. $first's $branch holds the commit, so fix on top of it and release again."; exit 1; }
git rev-parse -q --verify "refs/tags/$tag" >/dev/null || git tag -a "$tag" -m "neckbeard $version" || exit 1
echo "== $first: main"
git push "$first" main || { echo "release: $first refused a fast-forward of main. Never force from here."; exit 1; }
for r in $remotes; do
  echo "== $r"
  git push "$r" main "$tag" || { echo "release: $r refused a fast-forward. Never force from here."; exit 1; }
done
echo "== $first: delete $branch"
git push "$first" ":refs/heads/$branch" || echo "release: couldn't delete $first's $branch; delete it by hand (git push $first :refs/heads/$branch)"
exit 0
