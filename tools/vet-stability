#!/usr/bin/env python3
"""How much do repeated reports on one unchanged target agree?

    tools/vet-stability REPORT REPORT [REPORT ...]

Reads the reports tools/vet wrote (the same target, run more than once) and prints the verdict
and the five counts of each, then every conflict with the number of reports that found it
("found in 4 of 5"). Needs only python3: no claude, no login, no model cost. Exit 0 when every
report has the same verdict and the same conflict list, 1 when they differ, 2 on bad input.

A conflict is identified by the rule it breaks, not by its wording or its source, since the
judge words the same finding differently each run and often names no file. The rule is the
reader's rule file (the `rules/<name>.md` in the "held in" cell) and its number, taken from
"held in" or else from the "collides with" cell ("rule 6", "#6", "Rule 6"), so ", rule 6" and
"(rule 6)" are the same. Several findings against one rule in a report (the worker role and
the queue skill both overriding the model) count as one; the output says so when a report's
conflict count is larger. A conflict with no rule file to read falls back to its "held in"
words, so a report that names none can read as unstable when it is not.
"""
import collections, re, sys

# debt: the key leans on the table layout in SKILL.md Step 4 (it says | collides with | held in);
# a change there needs the same change here. The test builds reports in that shape.
VERDICT_RE = re.compile(r"^> ## (?:🟥|🟧|🟨|🟩) (.+?)(?: · .*)?$", re.M)
SORT_ROWS = ["conflicts", "covered", "new standing", "new skill", "dropped"]
COUNT_RE = re.compile(r"^\| \S+ \| \*\*(conflicts|already covered|new, standing rule|new, on-demand skill|dropped)[^|]*\| \*\*(\d+)\*\*", re.M)
LABEL = {"conflicts": "conflicts", "already covered": "covered", "new, standing rule": "new standing",
         "new, on-demand skill": "new skill", "dropped": "dropped"}
RULE_FILE_RE = re.compile(r"(rules/[\w.-]+\.md)")
RULE_RE = re.compile(r"(?:rules?|#)\s*(\d+)", re.I)


def rule_key(collides, held):
    """The reader's rule a conflict breaks: its file from "held in", its number from either cell."""
    f = RULE_FILE_RE.search(held)
    n = RULE_RE.search(held) or RULE_RE.search(collides)
    if not f:
        return re.sub(r"\W+", " ", held.lower()).strip()
    return f.group(1) + (f" rule {n.group(1)}" if n else "")


def conflicts_section(text):
    m = re.search(r"^## ⛔ Conflicts.*?\n(.*?)(?=^## |\Z)", text, re.M | re.S)
    return m.group(1) if m else ""


def parse(path):
    text = open(path, encoding="utf-8").read()
    v = VERDICT_RE.search(text)
    if not v:
        print(f"vet-stability: {path} has no verdict banner", file=sys.stderr)
        sys.exit(2)
    counts = {LABEL[k]: int(n) for k, n in COUNT_RE.findall(text)}
    keys = []
    for row in conflicts_section(text).splitlines():
        cells = [c.strip() for c in row.strip().strip("|").split("|")]
        if len(cells) >= 4 and cells[0].isdigit():
            keys.append(rule_key(cells[2], cells[3]))
    return v.group(1).strip(), counts, keys, len(keys)


def main(paths):
    if len(paths) < 2:
        print("usage: tools/vet-stability REPORT REPORT [REPORT ...]", file=sys.stderr)
        sys.exit(2)
    runs = [parse(p) for p in paths]
    n = len(runs)
    print(f"{n} reports")
    for p, (verdict, counts, keys, rows) in zip(paths, runs):
        print(f"  {p}: {verdict}; " + " / ".join(f"{counts.get(r, '?')}" for r in SORT_ROWS) + "  (conflicts / covered / new standing / new skill / dropped)")
        if rows != len(set(keys)):
            print(f"    note: {rows} conflict rows but {len(set(keys))} distinct rules; findings against one rule are counted once")
    verdicts = collections.Counter(v for v, _, _, _ in runs)
    print("verdicts: " + ", ".join(f"{v} in {c} of {n}" for v, c in verdicts.most_common()))
    seen = collections.Counter(k for _, _, keys, _ in runs for k in set(keys))
    for key, c in seen.most_common():
        print(f"  conflict found in {c} of {n}: {key}")
    if not seen:
        print("  no conflicts in any report")
    stable = len(verdicts) == 1 and all(c == n for c in seen.values())
    print("stable" if stable else "NOT stable: the reports disagree")
    return 0 if stable else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
