#!/usr/bin/env python3
"""fit VERDICT.json PROSE.json [--label L] [--target T] [--verdict-text TEXT] [--baseline FILE]: the fit report's verdict strip and seven fit cards.

VERDICT.json is `tools/units-verdict UNITS ANSWERS --json`: the verdict, the counts and one record per unit. PROSE.json is the prose
judge's {"why": text, "do_this": [step, ...], "patch": text}. Every number, colour, mark and gist comes from the records, never from
the prose: the prose fills the Why this verdict paragraph, the Do this steps and the Proposed rules patch, and nothing else.
Prints the strip, then the cards Why this verdict, Conflicts, Already covered, Keep, Dropped, Do this and Proposed rules patch.
--label and --target name what the verdict is against ("the sample reader", the plugin); --verdict-text is the "Verdict is relative"
line; --baseline is the file tools/vet wrote (the Baseline line, the Judge line and the Rule files block), put in raw under it.
Exit 2 with nothing on stdout when an input is unreadable or the verdict is one units-verdict cannot print. Card markup comes from tools/cards.py.
"""
import json, os, sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from cards import card

VERDICT_MARK = {"INSTALL": "\U0001F7E9", "INSTALL WITH CHANGES": "\U0001F7E8", "COPY RULES, SKIP PLUGIN": "\U0001F7E8", "DON'T INSTALL": "\U0001F7E5"}
RED, ORANGE, GREEN, WHITE, BLACK, STAR = "\U0001F7E5", "\U0001F7E7", "\U0001F7E9", "⬜", "⬛", "⭐"
NUMBER_WORDS = ["zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten"]


def die(msg):
    print(f"fit: {msg}", file=sys.stderr)
    sys.exit(2)


def num(n):
    return NUMBER_WORDS[n] if 0 <= n < len(NUMBER_WORDS) else str(n)


def plural(n, word, as_words=False):
    return f"{num(n) if as_words else n} {word}" + ("" if n == 1 else "s")


def marks(n, mark):
    """one mark per item up to five, then the mark and a count"""
    return mark * n if n <= 5 else f"{mark} ×{n}"


def cell(text, cut=160):
    t = " ".join(str(text).split()).replace("|", "\\|")
    return t if len(t) <= cut else t[:cut - 1] + "…"


def gist(count, pieces):
    """the count, then the first six words of each row joined with "; ", cut at 100 characters"""
    words = "; ".join(" ".join(str(p).split()[:6]) for p in pieces if str(p).strip())
    if len(words) > 100:
        words = words[:99] + "…"
    return f"{count} · {words}" if words else str(count)


def kept_phrase(counts, words):
    parts = [plural(n, w, words) for n, w in ((counts["kept_rules"], "rule"), (counts["kept_skills"], "skill")) if n]
    return " and ".join(parts)


def parse_args(argv):
    opts = {"--label": "the sample reader", "--target": "", "--verdict-text": "", "--baseline": ""}
    pos, i = [], 0
    while i < len(argv):
        if argv[i] in opts and i + 1 < len(argv):
            opts[argv[i]] = argv[i + 1]
            i += 2
        elif argv[i].startswith("--"):
            die(f"unknown option {argv[i]}")
        else:
            pos.append(argv[i])
            i += 1
    if len(pos) != 2:
        die("usage: fit VERDICT.json PROSE.json [--label L] [--target T] [--verdict-text TEXT] [--baseline FILE]")
    return pos, opts


def load(path, what):
    try:
        return json.load(open(path, encoding="utf-8"))
    except (OSError, ValueError) as e:
        die(f"can't read {what} {path}: {e}")


def main():
    (vpath, ppath), opts = parse_args(sys.argv[1:])
    v, prose = load(vpath, "the verdict"), load(ppath, "the prose")
    try:
        verdict, c, units = v["verdict"], v["counts"], v["units"]
        _ = [c[k] for k in ("conflicts", "covered", "keep", "dropped", "new_standing", "new_skill", "kept_rules", "kept_skills")]
        why, steps, patch = prose["why"], prose["do_this"], prose["patch"]
        assert isinstance(why, str) and isinstance(patch, str) and isinstance(steps, list) and all(isinstance(s, str) for s in steps)
    except (KeyError, TypeError, AssertionError):
        die("the verdict or the prose lacks a field (verdict, counts, units; why, do_this, patch)")
    if verdict not in VERDICT_MARK:
        die(f"unknown verdict {verdict!r}")
    mark = VERDICT_MARK[verdict]
    kept = kept_phrase(c, True)
    subtitle = ("keep " + kept + (" as text" if verdict.startswith("COPY RULES") else "")) if kept else "nothing worth keeping"
    keep_count = kept_phrase(c, False).replace(" and ", " + ") or "none"
    inside = f" ({kept_phrase(c, False).replace(' and ', ', ')})" if kept else ""
    strip = [f"> **{mark} {verdict}** · {subtitle}  ",
             f"> ⛔ **{c['conflicts']}** conflicts · \U0001F501 **{c['covered']}** covered · {GREEN} **{c['keep']}** keep{inside} · \U0001F5D1️ **{c['dropped']}** dropped  ",
             f"> *against {opts['--label']}" + (f" ({opts['--target']})" if opts["--target"] else "") + "*"]

    conflicts = {}
    for u in units:
        for x in u["conflicts"]:
            conflicts.setdefault(x["n"], x)
    nums = {u["id"]: sorted({x["n"] for x in u["conflicts"]}) for u in units}
    of = lambda bucket: [u for u in units if u["bucket"] == bucket]

    # Why this verdict: the prose paragraph, the relative line, the baseline block (raw: it holds a card of its own), the sorted table
    why_lines = why.split("\n")
    body = why_lines + [""]
    if opts["--verdict-text"]:
        body += [opts["--verdict-text"], ""]
    slot = len(body)
    body += ["BASELINE", ""] if opts["--baseline"] else []
    body += ["**How its rules sorted**", "", "| | verdict | count | |", "|:--:|---|:--:|---|",
             f"| ⛔ | **conflicts** with a rule you run | **{c['conflicts']}** | {marks(c['conflicts'], RED)} |",
             f"| \U0001F501 | **already covered** | **{c['covered']}** | {marks(c['covered'], WHITE)} |",
             f"| \U0001F195 | **new, standing rule** | **{c['new_standing']}** | {marks(c['new_standing'], GREEN)} |",
             f"| \U0001F195 | **new, on-demand skill** | **{c['new_skill']}** | {marks(c['new_skill'], GREEN)} |",
             f"| \U0001F5D1️ | **dropped** (persona, extras, no value) | **{c['dropped']}** | {marks(c['dropped'], BLACK)} |"]
    why_card = card("\U0001F4DD", "Why this verdict", subtitle, body)
    if opts["--baseline"]:
        try:
            raw = open(opts["--baseline"], encoding="utf-8").read().strip("\n").split("\n")
        except OSError as e:
            die(f"can't read the baseline: {e}")
        why_card[2 + slot:2 + slot + 1] = raw
    cards = [why_card]

    rows = ["| # | it says | collides with | held in | |", "|:--:|---|---|---|:--:|"]
    for n in sorted(conflicts):
        x = conflicts[n]
        rule = x["reader_rule"].split(": ", 1)[-1]
        rows.append(f'| {n} | "{cell(x["quote"])}" | "{cell(rule)}" | {cell(x["held_in"])} | {RED if x["hard_stop"] else ORANGE} |')
    cards.append(card("⛔", "Conflicts", gist(len(conflicts) or "none", [conflicts[n]["quote"] for n in sorted(conflicts)]), rows if conflicts else ["None."]))

    cov = of("covered")
    rows = ["| its rule | covered by | held in |", "|---|---|---|"] + [f"| {cell(u['quote'])} | {cell(u['covered_by'])} | {cell(u['held_in'])} |" for u in cov]
    cards.append(card("\U0001F501", "Already covered", gist(len(cov) or "none", [u["quote"] for u in cov]), rows if cov else ["None."]))

    keep = of("keep")
    text = lambda u: u["quote"] or u["heading"]
    rows = ["| # | rule or skill | kind | |", "|:--:|---|:--:|:--:|"] + [f"| {i} | {cell(text(u))} ({cell(u['file'])}) | {u['kind']} | {STAR if u['star'] else GREEN} |" for i, u in enumerate(keep, 1)]
    cards.append(card(GREEN, "Keep", gist(keep_count, [text(u) for u in keep]), rows if keep else ["None."]))

    drop = of("dropped")
    name = lambda u: f"`{u['file']}" + ("" if u["heading"] == "(top)" else f" > {u['heading']}") + "`" + (f" ⛔{','.join(map(str, nums[u['id']]))}" if nums[u["id"]] else "")
    cards.append(card("\U0001F5D1️", "Dropped", gist(len(drop) or "none", [u["file"] for u in drop]), [" · ".join(name(u) for u in drop)] if drop else ["None."]))

    cards.append(card("✅", "Do this", gist(plural(len(steps), "step"), steps), [f"- {WHITE} {i}. {s}" for i, s in enumerate(steps, 1)] if steps else ["None."]))
    cards.append(card("\U0001F4CB", "Proposed rules patch", gist(keep_count, [text(u) for u in keep]), patch.split("\n")))

    out = strip
    for cd in cards:
        out += [""] + cd
    sys.stdout.write("\n".join(out) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
