#!/usr/bin/env python3
"""part1 DOSSIER [--commit SHA]: print "## What it adds", what a tool adds to a session, from the dossier alone.

DOSSIER is the JSON inventory.py writes. This reads only its `target`: never `current_rules`, never the target
folder, so nothing here mentions a reader's rules. Output is sorted and has no clock in it, so two runs on one
dossier are byte-identical. tools/vet puts it in the report just before "## ⚡ At a glance".

Each card is a `### ` heading and each section under it one `- <label>:` line, in the state target.read_status gives:
  read, entries     the label's line, then each entry on its own `  - ` line (no state word)
  read, none        `none`
  partial           `partly read`, then the entries found, then `  - not read: <notes joined by "; ">` (omitted with no notes)
  failed            `not read: <notes>`
  not-applicable    `not applicable`
A dossier with no read_status exits 2: without it the card cannot tell "none" from "could not read".

Field (under target) -> label (card), the section whose read_status gives its state:
  skills[]                        Skills (Injects)               skills
  rule_files[]                    Rule files (Injects)           rule_files
  hooks.injected_content[]        Hook-injected text (Injects)   hooks
  hooks.events                    Hooks (Hooks)                  hooks      (+ hooks_reach_subagents, its _basis)
  agents[]                        Agents (Subagents and commands)    agents
  commands[]                      Commands (Subagents and commands)  commands
  persistence_candidates[]        Persistence candidates (State it may leave)   persistence_candidates
  mcp_servers.servers[]           MCP servers (Reaches outside the session)     mcp_servers
  plugin_json                     plugin.json (Source)           plugin_json
  marketplace                     Marketplace (Source)           marketplace
  kind, path, plugin_json.name/.version, --commit   Kind, Name, Version, Commit (Source), no section

A hooks section read with injected_content null and an injected_content_note prints the note as not read, never none.
An entry with `refused`, or with bytes and text both None, prints `<name>: not read`. Notes are cleaned before they
print: a hook command in one becomes its script (script_of), any other absolute path its basename."""
import json, os, re, shlex, sys
from urllib.parse import urlsplit

INTERPRETERS = {"bash", "sh", "zsh", "python", "python3", "node", "uv", "uvx", "npx", "deno"}
FOOTER = ('Load timing is how Claude Code loads skills, not measured here. Tokens are estimated as bytes / 4; '
          'where the inventory fell back to a character count, "bytes" counts characters.')
ABS_PATH = re.compile(r"(?<![\w/.~$}])/[\w.@+-]+(?:/[\w.@+-]+)+")


def script_of(command, root=""):
    """The script a hook command runs, with no arguments: skip an interpreter to its next non-flag token, strip
    ${CLAUDE_PLUGIN_ROOT}/ or the target path, print what is still absolute as its basename."""
    try:
        toks = shlex.split(command) if isinstance(command, str) else []
    except ValueError:
        return "<unparsed command>"
    if not toks:
        return "<unparsed command>"
    tok = toks[0]
    if os.path.basename(tok) in INTERPRETERS:
        rest = [t for t in toks[1:] if not t.startswith("-")]
        if not rest:
            return os.path.basename(tok)
        tok = rest[0]
    for prefix in ("${CLAUDE_PLUGIN_ROOT}/", "$CLAUDE_PLUGIN_ROOT/", root.rstrip("/") + "/" if root else None):
        if prefix and tok.startswith(prefix):
            tok = tok[len(prefix):]
            break
    return os.path.basename(tok) if tok.startswith("/") else tok


def clean_note(note, root=""):
    """A read_status note as printed: hook commands in an unidentifiable or unresolved list reduced to their script,
    then the target path dropped and every other absolute path cut to its basename."""
    m = re.match(r"^(.*?\b(?:unidentifiable|unresolved) hooks: )(.*)$", str(note), re.S)
    if m:
        items = re.split(r"; (?=[A-Z][A-Za-z]+: )", m.group(2))
        fixed = []
        for it in items:
            e = re.match(r"^([A-Z][A-Za-z]+): (.*)$", it, re.S)
            fixed.append(f"{e.group(1)}: {script_of(e.group(2), root)}" if e else it)
        note = m.group(1) + "; ".join(fixed)
    note = str(note).replace("\n", " ")
    if root:
        note = note.replace(root.rstrip("/") + "/", "")
    return ABS_PATH.sub(lambda m: os.path.basename(m.group(0)), note)


def toks(n):
    return f"{n} bytes, ~{n // 4} tokens"


def block(label, section, entries, root, tail=()):
    """The lines for one section: its state from read_status, its entries when it has them."""
    state, notes = section
    notes = [clean_note(n, root) for n in notes]
    if state == "not-applicable":
        return [f"- {label}: not applicable"]
    if state == "failed":
        return [f"- {label}: not read" + (": " + "; ".join(notes) if notes else "")]
    entries = sorted(entries)
    if state == "partial":
        return ([f"- {label}: partly read"] + [f"  - {e}" for e in entries] + [f"  - {t}" for t in tail]
                + ([f"  - not read: {'; '.join(notes)}"] if notes else []))
    if not entries:
        return [f"- {label}: none"]
    return [f"- {label}:"] + [f"  - {e}" for e in entries] + [f"  - {t}" for t in tail]


def name_of(e):
    return e.get("name") or os.path.basename(e.get("source") or e.get("path") or "") or "(unnamed)"


def unread(e):
    return bool(e.get("refused")) or (e.get("bytes") is None and e.get("text") is None)


def not_read(e):
    return f"{name_of(e)}: not read" + (f": {e['refused']}" if e.get("refused") else "")


def render(d, commit):
    t = d["target"]
    root = t.get("path") or ""
    rs = t["read_status"]
    sec = lambda name: (rs.get(name, {}).get("state", "failed"),
                        rs.get(name, {}).get("notes") or (["no read_status for this section"] if name not in rs else []))
    capped = lambda e: " (read capped)" if e.get("truncated") else ""
    hooks = t.get("hooks") if isinstance(t.get("hooks"), dict) else {}

    skills = []
    for s in t.get("skills") or []:
        if unread(s):
            skills.append(not_read(s))
        else:
            b = s["bytes"] if s.get("bytes") is not None else 0
            skills.append(f"{name_of(s)}: description every session ({len(s.get('description') or '')} chars); "
                          f"the file on demand ({toks(b)}){capped(s)}")
    rules = []
    for r in t.get("rule_files") or []:
        p = r.get("path") or ""
        rel = os.path.basename(p) if t.get("kind") == "rule-file" or not root or not p.startswith(root.rstrip("/") + "/") else os.path.relpath(p, root)
        rules.append(not_read(r) if unread(r) else f"{rel or name_of(r)}: every session ({toks(r['bytes'])}){capped(r)}")
    injected = [f"{i['file']}: {toks(i['bytes'])}" for i in hooks.get("injected_content") or [] if i.get("bytes") is not None]
    hsec = sec("hooks")
    if hsec[0] == "read" and hooks.get("injected_content") is None and hooks.get("injected_content_note"):
        hsec = ("failed", [hooks["injected_content_note"]])
    events = []
    for event, cmds in (hooks.get("events") or {}).items():
        for c in cmds if isinstance(cmds, list) else []:
            m = c.get("matcher") if isinstance(c, dict) else None
            events.append(f"{event}{f' ({m})' if m else ''}: {script_of(c.get('command') if isinstance(c, dict) else None, root)}")
    reach = hooks.get("hooks_reach_subagents")
    basis = hooks.get("hooks_reach_subagents_basis")
    reach_line = "reaches subagents: " + ("unknown" if reach is None else json.dumps(reach) + (f" ({basis})" if basis else ""))
    agents = [not_read(a) if unread(a) else name_of(a) for a in t.get("agents") or []]
    commands = [not_read(c) if unread(c) else name_of(c) for c in t.get("commands") or []]
    persist = [p if isinstance(p, str) else str(p.get("path") or p.get("file") or p) for p in t.get("persistence_candidates") or []]
    persist = [os.path.basename(p) if p.startswith("/") and not (root and p.startswith(root.rstrip("/") + "/")) else p[len(root.rstrip("/")) + 1:] if root and p.startswith(root.rstrip("/") + "/") else p for p in persist]
    servers = []
    for s in ((t.get("mcp_servers") or {}).get("servers") or []):
        how = ""
        if s.get("url"):
            u = urlsplit(s["url"])
            how = f"{u.scheme}://{u.hostname}" if u.scheme and u.hostname else "url"
        elif s.get("command"):
            how = os.path.basename(shlex.split(s["command"])[0]) if _splits(s["command"]) else "command"
        servers.append(f"{name_of(s)} ({', '.join(x for x in (s.get('transport'), how) if x)})")
    pj = t.get("plugin_json") if isinstance(t.get("plugin_json"), dict) else {}
    kind = t.get("kind") or "unknown"
    if pj.get("name"):
        name = f"{pj['name']} (from plugin.json)"
    elif kind == "rule-file" and t.get("rule_files"):
        name = os.path.basename(t["rule_files"][0].get("path") or "") or name_of(t["rule_files"][0])
    else:
        name = os.path.basename(root.rstrip("/")) or "unknown"
    version = f"{pj['version']} (from plugin.json)" if pj.get("version") else "no version"
    mk = t.get("marketplace")
    mk_entries = [str(mk.get("name") or "(unnamed)")] if isinstance(mk, dict) and mk else []

    out = ["## What it adds", "", "### Injects"]
    out += block("Skills", sec("skills"), skills, root)
    out += block("Rule files", sec("rule_files"), rules, root)
    out += block("Hook-injected text", hsec, injected, root)
    out += ["", "### Hooks"] + block("Hooks", sec("hooks"), events, root, tail=[reach_line])
    out += ["", "### Subagents and commands"] + block("Agents", sec("agents"), agents, root) + block("Commands", sec("commands"), commands, root)
    out += ["", "### State it may leave"] + block("Persistence candidates", sec("persistence_candidates"), persist, root)
    out += ["", "### Reaches outside the session"] + block("MCP servers", sec("mcp_servers"), servers, root)
    out += ["", "### Source", f"- Kind: {kind}", f"- Name: {name}", f"- Version: {version}"]
    out += block("plugin.json", sec("plugin_json"), ["name and version, shown above"] if pj else [], root)
    out += block("Marketplace", sec("marketplace"), mk_entries, root)
    out += [f"- Commit: {commit or 'commit not given'}", "", FOOTER]
    return "\n".join(out) + "\n"


def _splits(command):
    try:
        return bool(shlex.split(command))
    except ValueError:
        return False


def main(argv):
    commit, args = None, []
    it = iter(argv)
    for a in it:
        if a == "--commit":
            commit = next(it, None)
            if not commit:
                break
        else:
            args.append(a)
    if len(args) != 1 or (commit is None and "--commit" in argv):
        print("usage: part1 DOSSIER [--commit SHA]", file=sys.stderr)
        return 2
    try:
        d = json.load(open(args[0], encoding="utf-8"))
        t = d["target"]
    except (OSError, ValueError, KeyError, TypeError) as e:
        print(f"part1: cannot read a dossier from {args[0]}: {e}", file=sys.stderr)
        return 2
    if not isinstance(t, dict) or not isinstance(t.get("read_status"), dict):
        print("part1: dossier has no read_status; rerun inventory.py", file=sys.stderr)
        return 2
    sys.stdout.write(render(d, commit))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
