#!/usr/bin/env python3
"""units-verdict UNITS ANSWERS [ANSWERS ...] [--json]: the verdict and counts, computed by code from a judge's per-unit answers.

UNITS is what tools/rule-units wrote. Each ANSWERS file is the judge's JSON: {"answers": [{"id": "u1", "skill": ...,
"conflicts": [...], "rules": ..., "why": ...}, ...], "carrying_cost": ...}, one answer for every unit, no more. Each unit gets three
answers, because they are three questions:
- skill: keep or drop. Is this section part of a skill, command or agent worth keeping as shipped?
- conflicts: every sentence in it that breaks a reader rule, each {"quote", "reader_rule", "held_in", "hard_stop"}; [] when none.
  Written by tools/units-confirm merge from the confirmed candidates, never by the answering judge.
- rules: new-standing, new-skill-text, duplicate or none. What general rule does it hold that matters outside the
  skill? A rule in an on-demand skill applies only while that skill is loaded, so a general rule is worth copying
  as a standing rule even when the plugin is installed. With several, the first in that order.

carrying_cost is one more answer for the whole target, Step 2's carrying-cost cases: install (always-on cost, and at least one rule you would
have written yourself), copy (always-on cost, nothing worth carrying) or reader-decides (exactly one rule survives). It is read only when UNITS
says the target has an always-on cost: tools/rule-units writes "always_on": {"session_start": bool, "subagents": bool} from the dossier's hooks
(an unread hook counts as true), and either flag true makes carrying_cost required (a file without it is refused). With no always-on cost it is ignored
when valid. A UNITS file with no "always_on" key (written before this field) gets the verdict rule without the carrying cost and one stderr note.

With one ANSWERS file it prints the counts and the verdict; with several it also prints, per unit, how often the runs
agreed on each answer. Exit 0 when every file is valid (and, with several, when they agree on the verdict and on
every unit), 1 when several valid files disagree, 2 on a bad file.

The verdict, from the counts:
- any skill kept, and carrying_cost copy or reader-decides (applied only with an always-on cost): COPY RULES, SKIP PLUGIN, whatever the conflicts;
- any skill kept otherwise: INSTALL with no conflict, INSTALL WITH CHANGES with one;
- else any new-standing or new-skill-text: COPY RULES, SKIP PLUGIN;
- else: DON'T INSTALL.
Rules to copy are listed whatever the verdict, and so are conflicts. With a skill kept, reader-decides adds one line naming the trade. The verdict and counts of tools/vet's fit report
come from here (verdict-stability-rules).
"""
import collections, json, sys

SKILL = ["keep", "drop"]
COST = ["install", "copy", "reader-decides"]
TRADE = ("  carrying cost: reader-decides. Exactly one rule survives, and one good rule is cheaper to copy as text than to carry as a permanent "
         "injection; the verdict leans to copy, and the reader decides.")
RULES = ["new-standing", "new-skill-text", "duplicate", "none"]


def verdict(skill, rules, cost=None):
    """cost: the answers' carrying_cost when the target has an always-on cost, else None (the rule ignores it)"""
    if skill["keep"] and cost in ("copy", "reader-decides"):
        return "COPY RULES, SKIP PLUGIN"
    if skill["keep"]:
        return "INSTALL WITH CHANGES" if rules["conflict"] else "INSTALL"  # rules["conflict"]: units with a conflict
    if rules["new-standing"] or rules["new-skill-text"]:
        return "COPY RULES, SKIP PLUGIN"
    return "DON'T INSTALL"


def conflict_problem(c):
    if not isinstance(c, dict) or not c.get("quote") or not c.get("reader_rule"):
        return "conflicts must be a list of {quote, reader_rule, held_in, hard_stop}, [] when none"
    for f in ("held_in",):
        if not isinstance(c.get(f), str) or not c[f]:
            return f"a conflict has no {f} (conflicts must be a list of {{quote, reader_rule, held_in, hard_stop}})"
    if not isinstance(c.get("hard_stop"), bool):
        return "a conflict's hard_stop must be true or false (conflicts must be a list of {quote, reader_rule, held_in, hard_stop})"
    return None


def kept(skill, rules):
    return skill == "keep" or rules in ("new-standing", "new-skill-text")


def load(path, ids, on=None):
    """({unit id: record}, carrying_cost), or a list of problems. A record has skill, rules, conflict ("conflict"/"no conflict") and the fields the fit cards read.
    on: whether the target has an always-on cost (None when UNITS does not say). carrying_cost is the answered value when on is true, else None."""
    try:
        doc = json.load(open(path, encoding="utf-8"))
        answers = doc["answers"]
    except (OSError, ValueError, KeyError, TypeError) as e:
        return [f"can't read answers: {e}"]
    got, problems = {}, []
    cost = doc.get("carrying_cost")
    if cost is not None and cost not in COST:
        problems.append(f"carrying_cost {cost!r} is not one of {', '.join(COST)}")
    elif on and cost is None:
        problems.append("carrying_cost is missing: the target has an always-on cost (a hook at session start or reaching subagents), so the answers must say "
                        f"{', '.join(COST)} (Step 2's carrying-cost cases)")
    for a in answers:
        if not isinstance(a, dict):
            problems.append(f"an answer is not an object: {a!r}")
            continue
        uid, skill, rules, conflicts = a.get("id"), a.get("skill"), a.get("rules"), a.get("conflicts")
        star, covered_by, held_in = a.get("star", False), a.get("covered_by", ""), a.get("held_in", "")
        if not isinstance(uid, str) or uid not in ids:
            problems.append(f"{uid}: no such unit" if isinstance(uid, str) else f"{uid!r}: no such unit")
        elif uid in got:
            problems.append(f"{uid}: answered twice")
        elif skill not in SKILL:
            problems.append(f"{uid}: skill {skill!r} is not one of {', '.join(SKILL)}")
        elif rules not in RULES:
            problems.append(f"{uid}: rules {rules!r} is not one of {', '.join(RULES)}")
        elif not isinstance(conflicts, list) or (bad := next((conflict_problem(c) for c in conflicts if conflict_problem(c)), None)):
            problems.append(f"{uid}: " + (bad if isinstance(conflicts, list) else "conflicts must be a list of {quote, reader_rule, held_in, hard_stop}, [] when none"))
        elif rules == "duplicate" and not (isinstance(covered_by, str) and covered_by):
            problems.append(f"{uid}: a duplicate answer needs covered_by (the reader rule that covers it)")
        elif rules == "duplicate" and not (isinstance(held_in, str) and held_in):
            problems.append(f"{uid}: a duplicate answer needs held_in (the reader file that holds it)")
        elif not isinstance(star, bool):
            problems.append(f"{uid}: star must be true or false")
        elif star and not kept(skill, rules):
            problems.append(f"{uid}: star is on a unit that is not kept")
        else:
            got[uid] = {"skill": skill, "rules": rules, "conflict": "conflict" if conflicts else "no conflict", "conflicts": conflicts, "star": star,
                        "quote": str(a.get("quote") or ""), "why": str(a.get("why") or ""),
                        "covered_by": covered_by if rules == "duplicate" else "", "held_in": held_in if rules == "duplicate" else ""}
    stars = [u for u, r in got.items() if r["star"]]
    if len(stars) > 1:
        problems.append("star: at most one kept unit may be starred, got " + ", ".join(stars))
    problems += [f"{u}: no answer" for u in ids if u not in got and not any(p.startswith(u + ":") for p in problems)]
    return problems or (got, cost if on else None)


def records(units, got, cost=None):
    """the --json document: the verdict, the counts and one record per unit, with each distinct conflict numbered from 1"""
    numbers, recs = {}, []
    c = collections.Counter()
    for u in units:
        r = got[u["id"]]
        k = kept(r["skill"], r["rules"])
        kind = "skill" if r["skill"] == "keep" or r["rules"] == "new-skill-text" else "rule"
        confs = []
        for x in r["conflicts"]:
            key = (" ".join(x["quote"].split()).lower(), x["reader_rule"])
            n = numbers.setdefault(key, len(numbers) + 1)
            confs.append({"n": n, **{f: x[f] for f in ("quote", "reader_rule", "held_in", "hard_stop")}})
        c["units"] += 1
        bucket = "keep" if k else ("covered" if r["rules"] == "duplicate" else "dropped")
        c[bucket] += 1
        c["new_standing"] += r["rules"] == "new-standing"
        c["new_skill"] += (r["skill"] == "keep" and r["rules"] != "new-standing") or (r["rules"] == "new-skill-text" and r["skill"] == "drop")
        c["kept_rules"] += k and kind == "rule"
        c["kept_skills"] += k and kind == "skill"
        c["skills_kept"] += r["skill"] == "keep"
        c["units_with_conflict"] += bool(confs)
        recs.append({"id": u["id"], "file": u["file"], "heading": u["heading"], "kind": kind, "bucket": bucket, "skill": r["skill"], "rules": r["rules"], "quote": r["quote"],
                     "why": r["why"], "covered_by": r["covered_by"], "held_in": r["held_in"], "star": r["star"], "conflicts": confs})
    keys = ["units", "conflicts", "covered", "keep", "dropped", "new_standing", "new_skill", "kept_rules", "kept_skills", "skills_kept", "units_with_conflict"]
    c["conflicts"] = len(numbers)
    skill = collections.Counter(r["skill"] for r in got.values())
    rules = collections.Counter(r["rules"] for r in got.values())
    rules["conflict"] = c["units_with_conflict"]
    return {"verdict": verdict(skill, rules, cost), "carrying_cost": cost, "counts": {k: c[k] for k in keys}, "units": recs}


def main():
    argv = [a for a in sys.argv[1:] if a != "--json"]
    as_json = len(argv) != len(sys.argv) - 1
    if len(argv) < 2 or (as_json and len(argv) != 2):
        print("usage: units-verdict UNITS ANSWERS [ANSWERS ...] [--json]   (--json takes one ANSWERS file)", file=sys.stderr)
        return 2
    doc = json.load(open(argv[0], encoding="utf-8"))
    units = doc["units"]
    ids = [u["id"] for u in units]
    flags = doc.get("always_on")
    on = (bool(flags.get("session_start") or flags.get("subagents")) if isinstance(flags, dict) else None)
    if on is None:
        print("units-verdict: the units file has no always_on, so the carrying-cost rule was not applied", file=sys.stderr)
    runs, bad = [], False
    for path in argv[1:]:
        got = load(path, set(ids), on)
        if isinstance(got, list):
            bad = True
            print(f"{path}: refused, {len(got)} problems")
            for p in got[:10]:
                print(f"  {p}")
            continue
        got, cost = got
        skill = collections.Counter(r["skill"] for r in got.values())
        rules = collections.Counter(r["rules"] for r in got.values())
        rules["conflict"] = sum(1 for r in got.values() if r["conflict"] == "conflict")
        v = verdict(skill, rules, cost)
        if as_json:
            print(json.dumps(records(units, got, cost), indent=1, ensure_ascii=False))
            return 0
        runs.append((path, got, v))
        print(f"{path}: {v}; skills kept {skill['keep']} of {len(ids)}; units with a conflict {rules['conflict']}; rules "
              + " / ".join(str(rules[r]) for r in RULES) + "  (" + " / ".join(RULES) + ")")
        if cost == "reader-decides" and skill["keep"]:
            print(TRADE)
    if bad:
        return 2
    if len(runs) < 2:
        return 0
    n = len(runs)
    vs = collections.Counter(v for _, _, v in runs)
    print("verdicts: " + ", ".join(f"{v} in {k} of {n}" for v, k in vs.most_common()))
    split = 0
    for axis, name in (("skill", "skill"), ("conflict", "conflict"), ("rules", "rules")):
        rows = []
        for u in units:
            seen = collections.Counter(got[u["id"]][axis] for _, got, _ in runs)
            if len(seen) > 1:
                rows.append((u, seen))
        split += len(rows)
        print(f"{name}: units answered the same in all {n} runs: {len(units) - len(rows)} of {len(units)}")
        for u, seen in rows:
            print(f"  {u['id']} {u['file']} > {u['heading']}: " + ", ".join(f"{b} {k}" for b, k in seen.most_common()))
    stable = len(vs) == 1 and not split
    print("stable" if stable else "NOT stable: the runs disagree")
    return 0 if stable else 1


if __name__ == "__main__":
    sys.exit(main())
