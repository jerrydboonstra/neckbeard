#!/usr/bin/env python3
"""units-verdict UNITS ANSWERS [ANSWERS ...]: the verdict and counts, computed by code from a judge's per-unit answers.

UNITS is what tools/rule-units wrote. Each ANSWERS file is the judge's JSON: {"answers": [{"id": "u1", "skill": ...,
"rules": ..., "why": ...}, ...]}, one answer for every unit, no more. Each unit gets two answers, because they are
two questions:
- skill: keep or drop. Is this section part of a skill, command or agent worth keeping as shipped?
- rules: conflict, new-standing, new-skill-text, duplicate or none. What does it hold that matters outside the skill?
  A rule in an on-demand skill applies only while that skill is loaded, so a general rule is worth copying as a
  standing rule even when the plugin is installed. With several, the first in that order.

With one ANSWERS file it prints the counts and the verdict; with several it also prints, per unit, how often the runs
agreed on each answer. Exit 0 when every file is valid (and, with several, when they agree on the verdict and on
every unit), 1 when several valid files disagree, 2 on a bad file.

The verdict, from the counts:
- any skill kept: INSTALL with no conflict, INSTALL WITH CHANGES with one;
- else any new-standing or new-skill-text: COPY RULES, SKIP PLUGIN;
- else: DON'T INSTALL.
Rules to copy are listed whatever the verdict. Part of the units prototype (verdict-prototype-units); SKILL.md does
not know about it yet.
"""
import collections, json, sys

SKILL = ["keep", "drop"]
RULES = ["conflict", "new-standing", "new-skill-text", "duplicate", "none"]


def verdict(skill, rules):
    if skill["keep"]:
        return "INSTALL WITH CHANGES" if rules["conflict"] else "INSTALL"
    if rules["new-standing"] or rules["new-skill-text"]:
        return "COPY RULES, SKIP PLUGIN"
    return "DON'T INSTALL"


def load(path, ids):
    """{unit id: (skill, rules)}, or a list of problems."""
    try:
        answers = json.load(open(path, encoding="utf-8"))["answers"]
    except (OSError, ValueError, KeyError, TypeError) as e:
        return [f"can't read answers: {e}"]
    got, problems = {}, []
    for a in answers:
        uid, skill, rules = a.get("id"), a.get("skill"), a.get("rules")
        if uid not in ids:
            problems.append(f"{uid}: no such unit")
        elif uid in got:
            problems.append(f"{uid}: answered twice")
        elif skill not in SKILL:
            problems.append(f"{uid}: skill {skill!r} is not one of {', '.join(SKILL)}")
        elif rules not in RULES:
            problems.append(f"{uid}: rules {rules!r} is not one of {', '.join(RULES)}")
        else:
            got[uid] = (skill, rules)
    problems += [f"{u}: no answer" for u in ids if u not in got and not any(p.startswith(u + ":") for p in problems)]
    return problems or got


def main():
    if len(sys.argv) < 3:
        print("usage: units-verdict UNITS ANSWERS [ANSWERS ...]", file=sys.stderr)
        return 2
    units = json.load(open(sys.argv[1], encoding="utf-8"))["units"]
    ids = [u["id"] for u in units]
    runs, bad = [], False
    for path in sys.argv[2:]:
        got = load(path, set(ids))
        if isinstance(got, list):
            bad = True
            print(f"{path}: refused, {len(got)} problems")
            for p in got[:10]:
                print(f"  {p}")
            continue
        skill = collections.Counter(s for s, _ in got.values())
        rules = collections.Counter(r for _, r in got.values())
        v = verdict(skill, rules)
        runs.append((path, got, v))
        print(f"{path}: {v}; skills kept {skill['keep']} of {len(ids)}; rules "
              + " / ".join(str(rules[r]) for r in RULES) + "  (" + " / ".join(RULES) + ")")
    if bad:
        return 2
    if len(runs) < 2:
        return 0
    n = len(runs)
    vs = collections.Counter(v for _, _, v in runs)
    print("verdicts: " + ", ".join(f"{v} in {k} of {n}" for v, k in vs.most_common()))
    split = 0
    for axis, name in ((0, "skill"), (1, "rules")):
        rows = []
        for u in units:
            seen = collections.Counter(got[u["id"]][axis] for _, got, _ in runs)
            if len(seen) > 1:
                rows.append((u, seen))
        split += len(rows)
        print(f"{name}: units answered the same in all {n} runs: {len(units) - len(rows)} of {len(units)}")
        for u, seen in rows:
            print(f"  {u['id']} {u['file']} > {u['heading']}: " + ", ".join(f"{b} {k}" for b, k in seen.most_common()))
    stable = len(vs) == 1 and not split
    print("stable" if stable else "NOT stable: the runs disagree")
    return 0 if stable else 1


if __name__ == "__main__":
    sys.exit(main())
