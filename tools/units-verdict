#!/usr/bin/env python3
"""units-verdict UNITS ANSWERS [ANSWERS ...]: the verdict and counts, computed by code from a judge's per-unit answers.

UNITS is what tools/rule-units wrote. Each ANSWERS file is the judge's JSON: {"answers": [{"id": "u1", "bucket": ...,
"why": ...}, ...]}, one answer for every unit, no more. With one ANSWERS file it prints the counts and the verdict;
with several it also prints, per unit, how often the runs agreed. Exit 0 when every file is valid (and, with several,
when they agree on the verdict and on every unit), 1 when several valid files disagree, 2 on a bad file.

Buckets, the strongest that applies (the order is the precedence, so a unit with a conflict and a good rule is a
conflict): conflict, install-skill, new-standing, new-skill-text, duplicate, dropped.

The verdict, from the counts:
- any install-skill: INSTALL with no conflict, INSTALL WITH CHANGES with one;
- else any new-standing or new-skill-text: COPY RULES, SKIP PLUGIN;
- else: DON'T INSTALL.
Part of the units prototype (verdict-prototype-units); SKILL.md does not know about it yet.
"""
import collections, json, sys

BUCKETS = ["conflict", "install-skill", "new-standing", "new-skill-text", "duplicate", "dropped"]


def verdict(counts):
    if counts["install-skill"]:
        return "INSTALL WITH CHANGES" if counts["conflict"] else "INSTALL"
    if counts["new-standing"] or counts["new-skill-text"]:
        return "COPY RULES, SKIP PLUGIN"
    return "DON'T INSTALL"


def load(path, ids):
    """{unit id: bucket}, or a list of problems."""
    try:
        answers = json.load(open(path, encoding="utf-8"))["answers"]
    except (OSError, ValueError, KeyError, TypeError) as e:
        return [f"can't read answers: {e}"]
    got, problems = {}, []
    for a in answers:
        uid, bucket = a.get("id"), a.get("bucket")
        if uid not in ids:
            problems.append(f"{uid}: no such unit")
        elif uid in got:
            problems.append(f"{uid}: answered twice")
        elif bucket not in BUCKETS:
            problems.append(f"{uid}: bucket {bucket!r} is not one of {', '.join(BUCKETS)}")
        else:
            got[uid] = bucket
    problems += [f"{u}: no answer" for u in ids if u not in got and not any(p.startswith(u + ":") for p in problems)]
    return problems or got


def main():
    if len(sys.argv) < 3:
        print("usage: units-verdict UNITS ANSWERS [ANSWERS ...]", file=sys.stderr)
        return 2
    units = json.load(open(sys.argv[1], encoding="utf-8"))["units"]
    ids = [u["id"] for u in units]
    runs, bad = [], False
    for path in sys.argv[2:]:
        got = load(path, set(ids))
        if isinstance(got, list):
            bad = True
            print(f"{path}: refused, {len(got)} problems")
            for p in got[:10]:
                print(f"  {p}")
            continue
        counts = collections.Counter(got.values())
        v = verdict(counts)
        runs.append((path, got, v))
        print(f"{path}: {v}; " + " / ".join(str(counts[b]) for b in BUCKETS) + "  (" + " / ".join(BUCKETS) + ")")
    if bad:
        return 2
    if len(runs) < 2:
        return 0
    n = len(runs)
    vs = collections.Counter(v for _, _, v in runs)
    print("verdicts: " + ", ".join(f"{v} in {k} of {n}" for v, k in vs.most_common()))
    split = []
    for u in units:
        seen = collections.Counter(got[u["id"]] for _, got, _ in runs)
        if len(seen) > 1:
            split.append((u, seen))
    print(f"units judged the same in all {n} runs: {len(units) - len(split)} of {len(units)}")
    for u, seen in split:
        print(f"  {u['id']} {u['file']} > {u['heading']}: " + ", ".join(f"{b} {k}" for b, k in seen.most_common()))
    stable = len(vs) == 1 and not split
    print("stable" if stable else "NOT stable: the runs disagree")
    return 0 if stable else 1


if __name__ == "__main__":
    sys.exit(main())
