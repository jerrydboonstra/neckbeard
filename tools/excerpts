#!/usr/bin/env python3
"""Keep the report excerpts in README.md and CASE-STUDIES.md in step with the reports.

Each case study that ran against a gallery plugin opens with that report's
excerpt between two markers. A fit report's excerpt is its summary table and its verdict strip; a facts report's is its title, header line and
summary table, then one line per facts card under "What it adds" (its read marker, name and gist, from the card's summary line). A report in
the old layout (no "## How it affects you" summary table) is refused:

    <!-- report:superpowers -->
    ...
    <!-- /report -->

The text between them is copied from examples/superpowers.md (or, for a name with
a folder, such as docs/neckbeard-report, from that file), never typed by hand, so
re-running the gallery cannot leave a page quoting an old report.

    tools/excerpts           rewrite every excerpt from its report
    tools/excerpts --check   exit 1, naming each excerpt that has drifted
"""
import html
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
DOCS = [ROOT / "README.md", ROOT / "CASE-STUDIES.md"]
BLOCK = re.compile(r"(<!-- report:([\w./-]+) -->\n)(.*?)(\n<!-- /report -->)", re.S)


CARD = re.compile(r"^<details>\s*<summary>(?:([^\s<]+) )?<b>(.+?)</b>(?: \u00b7 (.*))?</summary>$")


def layered_excerpt(report):
    """The excerpt of a 2.0-layout report: its summary table, and for a fit report the verdict strip, for a facts report the title,
    the header line and one `- <marker> **<name>** \u00b7 <gist>` line per facts card (the card's summary line, unescaped). None when the
    report has no summary table."""
    lines = report.splitlines()
    at = next((i for i, l in enumerate(lines) if l.strip() == "## How it affects you"), None)
    if at is None:
        return None
    table = []
    for l in lines[at + 1:]:
        if l.startswith("|"):
            table.append(l.rstrip())
        elif table:
            break
    if not table:
        return None
    facts = next((i for i, l in enumerate(lines) if l.strip() == "## What it adds"), None)
    strip_at = next((i for i, l in enumerate(lines[:facts] if facts is not None else lines) if i > at and l.startswith("> **")), None)   # the strip sits in the summary layer
    if strip_at is not None:   # a fit report: the table, then the strip block
        strip = []
        for l in lines[strip_at:]:
            if not l.startswith(">"):
                break
            strip.append(l.rstrip())
        return "\n".join(table + [""] + strip)
    title = next((l for l in lines if l.startswith("# ")), None)
    if not title or facts is None:
        return None
    header = next((l for l in lines[lines.index(title) + 1:] if l.strip()), None)
    cards = []
    for i, l in enumerate(lines[facts + 1:], facts + 1):
        if l.startswith("## ") or (l.strip() == "---" and re.match(r"\*\*\d \u00b7 ", (lines[i + 2] if i + 2 < len(lines) else ""))):   # the next layer's rule and label, not a rule inside a card
            break
        m = CARD.match(l)
        if m:
            cards.append("- " + (m.group(1) + " " if m.group(1) else "") + f"**{html.unescape(m.group(2))}**" + (f" \u00b7 {html.unescape(m.group(3))}" if m.group(3) else ""))
    if not header or not cards:
        return None
    return "\n".join(("> " + l).rstrip() for l in [title, "", header, ""] + table + [""] + cards)


def excerpt(name):
    """From examples/<name>.md: a fit report's summary table and verdict strip, or a facts report's title, header, table and one line per card."""
    # A bare name is a gallery report; a name with a folder in it (docs/neckbeard-report) is that file in the repo.
    path = ROOT / f"{name}.md" if "/" in name else ROOT / "examples" / f"{name}.md"
    new = layered_excerpt(path.read_text())
    if new:
        return new
    sys.exit(f"excerpts: {path.relative_to(ROOT)} is neither a fit report (summary table and verdict strip) nor a facts report (title, header line, summary table, \"What it adds\" cards)")


def main():
    check = "--check" in sys.argv[1:]
    stale, seen = [], 0
    for doc in DOCS:
        if not doc.is_file():
            continue
        text = doc.read_text()
        seen += len(BLOCK.findall(text))

        def fill(m):
            want = excerpt(m.group(2))
            if m.group(3) != want:
                stale.append(f"{doc.name}:{m.group(2)}")
            return m.group(1) + want + m.group(4)

        new = BLOCK.sub(fill, text)
        if not check and new != text:
            doc.write_text(new)
    if not seen:
        sys.exit("excerpts: no <!-- report:... --> blocks in README.md or CASE-STUDIES.md")
    if check:
        if stale:
            sys.exit("excerpts: out of step with the reports: " + ", ".join(stale) + ". Run tools/excerpts.")
        print(f"excerpts: {seen} in step with the reports")
        return
    print(f"excerpts: rewrote {', '.join(stale) or 'nothing, all in step'}")


if __name__ == "__main__":
    main()
