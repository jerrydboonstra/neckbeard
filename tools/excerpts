#!/usr/bin/env python3
"""Keep the report excerpts in README.md and CASE-STUDIES.md in step with the reports.

Each case study that ran against a gallery plugin opens with that report's
excerpt between two markers: a fit report's verdict and "At a glance" table, a
facts report's title, header line and "What it adds" headings with their top-level bullets (a bullet that ends in ":" says how many items it held):

    <!-- report:superpowers -->
    ...
    <!-- /report -->

The text between them is copied from examples/superpowers.md (or, for a name with
a folder, such as docs/neckbeard-report, from that file), never typed by hand, so
re-running the gallery cannot leave a page quoting an old report.

    tools/excerpts           rewrite every excerpt from its report
    tools/excerpts --check   exit 1, naming each excerpt that has drifted
"""
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
DOCS = [ROOT / "README.md", ROOT / "CASE-STUDIES.md"]
BLOCK = re.compile(r"(<!-- report:([\w./-]+) -->\n)(.*?)(\n<!-- /report -->)", re.S)


def counted(bullet, after):
    """A top-level bullet ending in ":" has children the excerpt drops, so it says how many instead of
    ending bare: "- Skills: 1 (name)" for one, "- Files: 29 (see the full report)" for more, "none" for
    no children. A last child "and N more, in: ..." counts as N."""
    kids, indent = [], None
    for l in after:
        if l.strip() and l[0] not in " \t":
            break
        item = l.strip()
        if not item.startswith("- "):
            continue
        depth = len(l) - len(l.lstrip())
        if indent is None:
            indent = depth
        if depth == indent:  # a deeper line is a detail of the item above it
            kids.append(item[2:].strip())
    if not kids:
        return bullet + " none"
    more = re.fullmatch(r"and (\d+) more, in:.*", kids[-1])
    n = len(kids) - 1 + int(more.group(1)) if more else len(kids)
    if n == 1 and not more:
        return f"{bullet} 1 ({kids[0].split(': ')[0]})"
    return f"{bullet} {n} (see the full report)"


def facts_excerpt(report):
    """The excerpt of a facts report (no verdict box): its title line, the one header line under it, and
    under "What it adds" each ### heading with its top-level bullet lines, no sub-bullets (a bullet ending in ":" gains the count of its dropped items). Quoted, so its
    headings stay out of the page's own outline."""
    lines = report.splitlines()
    title = next((l for l in lines if l.startswith("# ")), None)
    header = next((l for l in lines[lines.index(title) + 1:] if l.strip()), None) if title else None
    start = next((i for i, l in enumerate(lines) if l.strip() == "## What it adds"), None)
    if not title or not header or start is None:
        return None
    out = [title, "", header, ""]
    body = []
    for l in lines[start + 1:]:
        if l.startswith("## "):
            break
        body.append(l)
    for i, l in enumerate(body):
        if l.startswith("### "):
            if out[-1] != "":
                out.append("")
            out.append(l)
        elif l.startswith("- "):
            out.append(counted(l.rstrip(), body[i + 1:]) if l.rstrip().endswith(":") else l)
    while out and out[-1] == "":
        out.pop()
    return "\n".join(("> " + l).rstrip() for l in out)


def excerpt(name):
    """From examples/<name>.md: a fit report's verdict and At-a-glance table, or a facts report's facts."""
    # A bare name is a gallery report; a name with a folder in it (docs/neckbeard-report) is that file in the repo.
    path = ROOT / f"{name}.md" if "/" in name else ROOT / "examples" / f"{name}.md"
    report = path.read_text()
    # The verdict box: its headline and summary, without the closing
    # "Verdict is relative..." note, which the case study does not need.
    verdict = re.search(r"^> ## (.+\n(?:>.*\n)*?)>\n> Verdict is relative", report, re.M)
    glance = re.search(r"^\| \| \| \|\n(?:\|.*\n?)+", report, re.M)
    if verdict and glance:
        return f"> {verdict.group(1).rstrip()}\n\n{glance.group(0).rstrip()}"
    if not verdict and not glance:
        facts = facts_excerpt(report)
        if facts:
            return facts
    sys.exit(f"excerpts: {path.relative_to(ROOT)} is neither a fit report (verdict box and At-a-glance table) nor a facts report (title, header line, \"What it adds\")")


def main():
    check = "--check" in sys.argv[1:]
    stale, seen = [], 0
    for doc in DOCS:
        if not doc.is_file():
            continue
        text = doc.read_text()
        seen += len(BLOCK.findall(text))

        def fill(m):
            want = excerpt(m.group(2))
            if m.group(3) != want:
                stale.append(f"{doc.name}:{m.group(2)}")
            return m.group(1) + want + m.group(4)

        new = BLOCK.sub(fill, text)
        if not check and new != text:
            doc.write_text(new)
    if not seen:
        sys.exit("excerpts: no <!-- report:... --> blocks in README.md or CASE-STUDIES.md")
    if check:
        if stale:
            sys.exit("excerpts: out of step with the reports: " + ", ".join(stale) + ". Run tools/excerpts.")
        print(f"excerpts: {seen} in step with the reports")
        return
    print(f"excerpts: rewrote {', '.join(stale) or 'nothing, all in step'}")


if __name__ == "__main__":
    main()
