.DS_Store
__pycache__/
*.pyc

# A dossier embeds the FULL TEXT of every rule file it discovers: your global
# CLAUDE.md, your project CLAUDE.md, your personal skills, and the skills of
# every plugin you have enabled. A run from inside this repo produced 90,533
# bytes of exactly that, including private hostnames and private marketplace
# names.
#
# So: ignore every JSON except the two manifests this plugin actually ships.
# If a future file genuinely needs tracking, un-ignore it by name, deliberately.
*.json
!.claude-plugin/plugin.json
!.claude-plugin/marketplace.json
# A measurement's raw data is its evidence: the units prototype's per-run answers and unit lists.
!measurements/**/*.json
# Fixtures for tools/test_read_status.py: each JSON file by name, none by glob. Baselines sit in
# _baselines/ so a baseline is never part of the tree a fixture's own inventory reads.
!tools/fixtures/read-status/_outside.json
!tools/fixtures/read-status/_baselines/*.baseline.json
!tools/fixtures/read-status/*/.mcp.json
!tools/fixtures/read-status/*/plugin.json
!tools/fixtures/read-status/*/.claude-plugin/plugin.json
!tools/fixtures/read-status/*/.claude-plugin/marketplace.json
!tools/fixtures/read-status/*/hooks/hooks.json
!tools/fixtures/read-status/hooks-bad-json/hooks/h.json
!tools/fixtures/read-status/*/plugins/*/.claude-plugin/plugin.json
!tools/fixtures/read-status/nested-plugins/inner/.claude-plugin/plugin.json
!tools/fixtures/read-status/nested-plugins/inner/hooks/hooks.json
!tools/fixtures/read-status/hooks-search-bad-json/data/broken.json
!tools/fixtures/read-status/outside-links/sub/link.json

# Evaluations quote the rules they compared against, for the same reason.
evaluations/

# Full-size logo sources (about 2 MB each). The README uses assets/logo.webp.
assets/source/

# This machine's release and deploy setup (see the Makefile).
local.mk
